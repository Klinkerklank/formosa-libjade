# Rootless systemd *user* unit that supervises the ephemeral bench runner loop.
# It replaces docker's --restart=always: run-runner.sh gives a fresh container
# per job, and this keeps that loop alive across crashes and reboots.
#
# Install (as the dedicated runner user, with lingering enabled so it survives
# logout/reboot):
#
#   loginctl enable-linger "$USER"
#   mkdir -p ~/.config/systemd/user ~/.config/bench-runner
#   cp bench-runner.service ~/.config/systemd/user/
#   # secrets + config, kept out of git and the process list; LABELS and NAME
#   # are mandatory and must be unique per instance on a host:
#   printf 'REPO=strub/jasmin-nist\nACCESS_TOKEN=<PAT>\nLABELS=bench\nNAME=bench-runner\nCPUSET=7\n' \
#       > ~/.config/bench-runner/env
#   chmod 600 ~/.config/bench-runner/env
#   # point ExecStart at your checkout, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now bench-runner
#
# Logs: journalctl --user -u bench-runner -f
[Unit]
Description=Ephemeral bench GitHub Actions runner (fresh container per job)
After=default.target

[Service]
Type=simple
EnvironmentFile=%h/.config/bench-runner/env
# Absolute path to run-runner.sh in your checkout (edit to match).
ExecStart=%h/runner/run-runner.sh
# run-runner.sh already loops; this restarts the loop itself if it ever dies.
Restart=always
RestartSec=5
# The TERM trap tears down the container promptly; if anything wedges, do not
# make `systemctl stop` wait the default 90s.
TimeoutStopSec=30

[Install]
WantedBy=default.target
