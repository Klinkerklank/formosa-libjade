# Rootless systemd *user* template unit that supervises one ephemeral runner
# loop; the instance name selects the env file (runner@bench-runner reads
# ~/.config/bench-runner/env), so one host can serve several instances.
# It replaces docker's --restart=always: run-runner.sh gives a fresh container
# per job, and this keeps that loop alive across crashes and reboots.
# Install instructions: README.md; instance variables: run-runner.sh.
[Unit]
Description=Ephemeral GitHub Actions runner %i (fresh container per job)
After=default.target

[Service]
Type=simple
EnvironmentFile=%h/.config/%i/env
# Absolute path to run-runner.sh in your checkout (edit to match).
ExecStart=%h/runner/run-runner.sh
# run-runner.sh already loops; this restarts the loop itself if it ever dies.
Restart=always
RestartSec=5
# The TERM trap tears down the container promptly; if anything wedges, do not
# make `systemctl stop` wait the default 90s.
TimeoutStopSec=30

[Install]
WantedBy=default.target
