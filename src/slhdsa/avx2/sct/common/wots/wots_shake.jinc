// namespace for the base_w computation of the WOTS+ message parts
namespace baseb_wots_m {
  param int B      = SPX_W;
  param int LG_B   = SPX_LG_W;
  param int OUTLEN = SPX_LEN_1;
  param int INLEN  = SPX_N;
  require "../misc/baseb.jinc" // algorithm 4 of SLH-DSS: base_2^b
}

// namespace for the base_w computation of the WOTS+ checksum parts
namespace baseb_wots_c {
  param int B      = SPX_W;
  param int LG_B   = SPX_LG_W;
  param int OUTLEN = SPX_LEN_2;
  param int INLEN  = (SPX_LEN_2 * SPX_LG_W + 7) / 8;
  require "../misc/baseb.jinc" // algorithm 4 of SLH-DSS: base_2^b
}

/////////////////////// HELPER FUNCTIONS ///////////////////////

// checksum computation over the message parts
inline
fn __csum(
    reg ptr u32[SPX_LEN_1] msg // message input
) -> reg u32 // -> csum
{
    // register variables
    reg u32 csum; // checksum value

    inline int i;

    // resolve at compile time: sum_(i=0)^(len_1) w-1 = len_1 * (w-1)
    csum = SPX_LEN_1 * (SPX_W-1);

    // subtract the message parts to get sum_(i=0)^(len_1) w-1-msg[i]
    for i=0 to SPX_LEN_1 { csum -= msg[i]; }

    // the checksum is later converted into base-w digits by interpreting
    // its byte encoding from the most-significant bits first
    //
    // each base-w digit uses log(w) bits, so the total checksum bitlength is len_2*log(w)
    //
    // if this bitlength is not a multiple of 8, the checksum bits are not
    // correctly aligned to the start of the byte array
    //
    // there are len_2*log(w) mod 8 bits that are not correctly left-aligned
    // so we need to left-shift the csum value by (8-(len_2*log(w) mod 8)) mod 8 bits
    csum <<= ((8-((SPX_LEN_2*SPX_LG_W) % 8)) % 8); // all resolved at compile time

    return csum;
}

// compute for each chain how often its secret key value is
// iteratively hashed to obtain the WOTS+ signature values
inline
fn __chain_lengths(
    reg ptr u32[SPX_LEN] lengths, // out: chain lengths as integers
    reg ptr u8[SPX_N] msg         // message input
) -> reg ptr u32[SPX_LEN] // -> lengths
{
    // stack variables
    stack u8[(SPX_LEN_2 * SPX_LG_W + 7) / 8] csum_basew; // buffer for the checksum value as base-w bytes

    // register variables
    reg u32 csum;      // checksum value
    reg u32 csum_byte; // temporary variable for bitshifting and masking purposes

    inline int k;

    // compute the base-w message part indices
    lengths[0 : SPX_LEN_1] = baseb_wots_m::__base_b(lengths[0 : SPX_LEN_1], msg);

    // compute the checksum value
    csum = __csum(lengths[0 : SPX_LEN_1]);

    // convert the csum value into bytes, setting the least-significant bytes first
    for k=0 to (SPX_LEN_2 * SPX_LG_W + 7) / 8 {
        csum_byte = csum;  // copy the csum value
        csum_byte >>= k*8; // bitshift the next byte to the least-significant byte position
        csum_byte &= 0xFF; // compute mod 256
        csum_basew[((SPX_LEN_2 * SPX_LG_W + 7) / 8 - 1) - k] = (8u) csum_byte;
    }

    // compute the base-w checksum part indices, and append to the message part indices
    lengths[SPX_LEN_1 : SPX_LEN_2] = baseb_wots_c::__base_b(lengths[SPX_LEN_1 : SPX_LEN_2], csum_basew);

    return lengths;
}

//////////////////// PARALLELISED CHAINING /////////////////////
//
// F and PRF of the chains of one WOTS+ instance are computed four at a time
// on the four-way AVX2 Keccak (thash_x4, ../hash/shake256_x4/thash_x4.jinc);
// the LEN chains are processed as WOTS_X4_LANES lanes, the last batch padded
// with dummy lanes.

param int WOTS_X4_LANES = ((SPX_LEN + 3) / 4) * 4; // LEN rounded up to a multiple of 4
param int WOTS_X4_BATCHES = WOTS_X4_LANES / 4;      // number of four-lane batches

/*-------------------------------------------------------------+
| ALGORITHM 5 FROM SLH-DSS (FIPS 205), ALL CHAINS AT ONCE      |
| Advances every chain j of a WOTS+ instance from position     |
| start[j] to position stop[j], four chains at a time.         |
| The four lanes of a batch step together from the smallest    |
| start to the largest stop of the batch; a lane only takes    |
| the new value while start[j] <= pos < stop[j]. The positions |
| are public (they follow from the message), the selection is  |
| branch-free.                                                 |
+-------------------------------------------------------------*/
fn wots_chains_x4(
    reg ptr u8[WOTS_SIG] chains, // in/out: the LEN chain values
    reg ptr u32[SPX_LEN] start,  // start position of every chain
    reg ptr u32[SPX_LEN] stop,   // stop position of every chain
    reg ptr u8[SPX_N] pkseed,    // PK.seed
    reg ptr u32[8] adrs          // ADRS (type WOTS_HASH, key pair address set)
) -> reg ptr u8[WOTS_SIG] // -> chains
{
    // stack variables
    stack u8[WOTS_X4_LANES*SPX_N] work; // chain values, padded to whole batches
    stack u8[4*SPX_N] next;             // the hashes of one step of a batch
    stack u32[8] w67;                   // chain and hash address of every lane
    stack u32[WOTS_X4_LANES] st;        // start positions (dummy lanes: 0)
    stack u32[WOTS_X4_LANES] len;       // number of steps (dummy lanes: 0)
    stack u8[SPX_N] seed;               // PK.seed, on the stack (its address public in the loop)
    stack u32[8] adrs_s;                // ADRS, on the stack (its address public in the loop)

    // register variables
    reg ptr u8[4*SPX_N] lanes; // pointer to the chain values of the current batch
    reg u64 batch;             // batch index
    reg u64 boff;              // byte offset of the batch in work
    reg u64 lane;              // lane index in st, len
    reg u32 pos;               // current position in the chains
    reg u32 hi;                // largest stop position of the batch
    reg u32 s;                 // start position of a lane
    reg u32 l;                 // number of steps of a lane
    reg u32 e;                 // stop position of a lane
    reg u32 d;                 // steps of a lane already taken at pos
    reg u32 big;               // larger than every position
    reg u32 zero;
    reg u32 cha;               // chain address
    reg u64 x y;               // temporary variables for copying

    inline int i j;

    () = #spill(chains);

    seed = __copy_nbytes(seed, pkseed);
    adrs_s = __adrs_clone(adrs_s, adrs);

    // per-lane start positions and step counts
    zero = 0;
    for i=0 to SPX_LEN {
        s = start[i];
        st[i] = s;
        l = stop[i];
        l -= s;
        len[i] = l;
    }
    for i=SPX_LEN to WOTS_X4_LANES {
        st[i] = zero;
        len[i] = zero;
    }

    // the chain values, padded with (unused) dummy lanes
    () = #unspill(chains);
    for i=0 to WOTS_SIG/8 {
        x = chains.[:u64 8*i];
        work.[:u64 8*i] = x;
    }
    for i=WOTS_SIG/8 to WOTS_X4_LANES*SPX_N/8 {
        work.[:u64 8*i] = 0;
    }

    batch = 0;
    while (batch < WOTS_X4_BATCHES) {
        // chain addresses 4*batch, ..., 4*batch + 3
        cha = (32u) batch;
        cha <<= 2;
        for j=0 to 4 {
            w67[2*j] = cha;
            cha += 1;
        }

        // pos = smallest start, hi = largest stop, over the lanes with steps to take
        pos = SPX_W;
        hi = 0;
        zero = 0;
        lane = batch;
        lane <<= 2;
        for j=0 to 4 {
            s = st[lane + j];
            l = len[lane + j];
            e = s;
            e += l;
            big = SPX_W;
            s = big if (l == 0);  // a lane without steps neither lowers pos ...
            e = zero if (l == 0); // ... nor raises hi
            pos = s if (s < pos);
            hi = e if (hi < e);
        }
        _ = #init_msf(); // the positions follow from public values; public after the fence

        boff = batch;
        boff *= 4*SPX_N;

        while (pos < hi) {
            // hash address pos in every lane
            for j=0 to 4 { w67[2*j+1] = pos; }

            () = #spill(batch, boff, pos, hi);

            // hash one step of all four lanes
            lanes = work[boff : 4*SPX_N];
            next = thash_x4_n::thash_x4(next, lanes, seed, adrs_s, w67);
            work[boff : 4*SPX_N] = lanes;

            () = #unspill(batch, boff, pos, hi);
            _ = #init_msf(); // the unspilled values are public after the fence

            // keep the new value of the lanes with start <= pos < start + len,
            // i.e. (pos - start) < len, unsigned
            lane = batch;
            lane <<= 2;
            for j=0 to 4 {
                d = pos;
                s = st[lane + j];
                d -= s;
                l = len[lane + j];
                for i=0 to SPX_N/8 {
                    x = work.[:u64 boff + j*SPX_N + 8*i];
                    y = next.[:u64 j*SPX_N + 8*i];
                    x = y if (d < l);
                    work.[:u64 boff + j*SPX_N + 8*i] = x;
                }
            }

            pos += 1;
        }

        batch += 1;
    }

    // write back the LEN real lanes
    () = #unspill(chains);
    _ = #init_msf(); // the unspilled pointer is public after the fence
    for i=0 to WOTS_SIG/8 {
        x = work.[:u64 8*i];
        chains.[:u64 8*i] = x;
    }

    return chains;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __wots_chains_x4(
    reg ptr u8[WOTS_SIG] chains,
    reg ptr u32[SPX_LEN] start,
    reg ptr u32[SPX_LEN] stop,
    reg ptr u8[SPX_N] pkseed,
    reg ptr u32[8] adrs
) -> reg ptr u8[WOTS_SIG] // -> chains
{
    chains = chains; start = start; stop = stop; pkseed = pkseed; adrs = adrs;

    chains = wots_chains_x4(chains, start, stop, pkseed, adrs);

    chains = chains;

    return chains;
}

// the LEN WOTS+ secret key values sk_j = PRF(PK.seed, SK.seed, skADRS_j), four at a time
fn wots_sk_x4(
    reg ptr u8[WOTS_SIG] chains, // out: the LEN secret key values
    reg ptr u8[SPX_N] skseed,    // SK.seed
    reg ptr u8[SPX_N] pkseed,    // PK.seed
    reg ptr u32[8] skadrs        // skADRS (type WOTS_PRF, key pair address set)
) -> reg ptr u8[WOTS_SIG] // -> chains
{
    // stack variables
    stack u8[WOTS_X4_LANES*SPX_N] work; // secret key values, padded to whole batches
    stack u8[4*SPX_N] seeds;            // SK.seed in every lane
    stack u32[8] w67;                   // chain and hash address of every lane
    stack u8[SPX_N] seed;               // PK.seed, on the stack (its address public in the loop)
    stack u32[8] adrs_s;                // skADRS, on the stack (its address public in the loop)

    // register variables
    reg ptr u8[4*SPX_N] lanes; // pointer to the values of the current batch
    reg u64 batch;             // batch index
    reg u64 boff;              // byte offset of the batch in work
    reg u32 cha;               // chain address
    reg u32 zero;
    reg u64 x;                 // temporary variable for copying

    inline int i j;

    () = #spill(chains);

    seed = __copy_nbytes(seed, pkseed);
    adrs_s = __adrs_clone(adrs_s, skadrs);

    for j=0 to 4 {
        seeds[j*SPX_N : SPX_N] = __copy_nbytes(seeds[j*SPX_N : SPX_N], skseed);
    }

    batch = 0;
    while (batch < WOTS_X4_BATCHES) {
        // chain addresses 4*batch, ..., 4*batch + 3, hash address 0
        zero = 0;
        cha = (32u) batch;
        cha <<= 2;
        for j=0 to 4 {
            w67[2*j] = cha;
            w67[2*j+1] = zero;
            cha += 1;
        }

        boff = batch;
        boff *= 4*SPX_N;

        () = #spill(batch, boff);
        lanes = work[boff : 4*SPX_N];
        lanes = thash_x4_n::thash_x4(lanes, seeds, seed, adrs_s, w67);
        () = #unspill(batch, boff);
        _ = #init_msf(); // the unspilled values are public after the fence
        work[boff : 4*SPX_N] = lanes;

        batch += 1;
    }

    () = #unspill(chains);
    _ = #init_msf(); // the unspilled pointer is public after the fence
    for i=0 to WOTS_SIG/8 {
        x = work.[:u64 8*i];
        chains.[:u64 8*i] = x;
    }

    return chains;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __wots_sk_x4(
    reg ptr u8[WOTS_SIG] chains,
    reg ptr u8[SPX_N] skseed,
    reg ptr u8[SPX_N] pkseed,
    reg ptr u32[8] skadrs
) -> reg ptr u8[WOTS_SIG] // -> chains
{
    chains = chains; skseed = skseed; pkseed = pkseed; skadrs = skadrs;

    chains = wots_sk_x4(chains, skseed, pkseed, skadrs);

    chains = chains;

    return chains;
}

//////////////////////// MAIN FUNCTIONS ////////////////////////

/*-------------------------------------------------------------+
| ALGORITHM 6 FROM SLH-DSS (FIPS 205)                          |
| Generates a WOTS+ public key.                                |
+-------------------------------------------------------------*/
fn wots_pkgen(
    reg ptr u8[SPX_N] pk,     // out: WOTS+ public key
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs       // ADRS
) -> reg ptr u8[SPX_N], reg ptr u32[8] // -> pk, adrs
{
    () = #spill(pk); // not needed until the end of the function

    // stack variables
    stack u32[8] adrs_key;     // ADRS clone for computing the WOTS+ secret and public key values
    stack u8[WOTS_SIG] chains; // all chain values concatenated
    stack u32[SPX_LEN] start;  // start position of every chain
    stack u32[SPX_LEN] stop;   // stop position of every chain

    // register variables
    reg u32 kpa; // ADRS key pair address
    reg u32 pos; // temporary variable for setting the positions

    inline int j;

    // clone ADRS (adrs_key here is what the SLH-DSS calls skADRS),
    // and set the correct type for computing WOTS+ secret keys
    adrs_key = __adrs_clone(adrs_key, adrs);
    adrs_key = __adrs_set_type_and_clear(adrs_key, SPX_ADRS_TYPE_WOTS_PRF);

    // get the key pair address from ADRS, and set it in adrs_key
    kpa = __adrs_get_key_pair_addr(adrs);
    adrs_key = __adrs_set_key_pair_addr(adrs_key, kpa);

    // compute all secret key values, four at a time
    () = #spill(adrs, pkseed);
    chains = __wots_sk_x4(chains, skseed, pkseed, adrs_key);
    () = #unspill(adrs, pkseed);
    _ = #init_msf(); // the unspilled values are public after the fence

    // hash every chain from the secret key value (position 0) to the public key value (position w-1)
    pos = 0;       for j=0 to SPX_LEN { start[j] = pos; }
    pos = SPX_W-1; for j=0 to SPX_LEN { stop[j]  = pos; }

    // compute all public key values, four chains at a time
    () = #spill(adrs, pkseed);
    chains = __wots_chains_x4(chains, start, stop, pkseed, adrs);
    () = #unspill(adrs, pkseed);
    _ = #init_msf(); // the unspilled values are public after the fence

    // adrs_key now becomes wotspkADRS (to avoid an ADRS clone)
    adrs_key = __adrs_set_type_and_clear(adrs_key, SPX_ADRS_TYPE_WOTS_PK);
    kpa = __adrs_get_key_pair_addr(adrs);
    adrs_key = __adrs_set_key_pair_addr(adrs_key, kpa);

    () = #unspill(pk);
    _ = #init_msf(); // the unspilled values are public after the fence

    // compute the WOTS+ overall public key by hashing all public key chain values together
    () = #spill(adrs);
    pk = __T_len(pk, pkseed, adrs_key, chains);
    () = #unspill(adrs);
    _ = #init_msf(); // the unspilled values are public after the fence

    return pk, adrs;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __wots_pkgen(
    reg ptr u8[SPX_N] pk,     // out: WOTS+ public key
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs       // ADRS
) -> reg ptr u8[SPX_N], reg ptr u32[8] // -> pk, adrs
{
    // split live-range of the parameters into two segments
    pk = pk; skseed = skseed; pkseed = pkseed; adrs = adrs;

    pk, adrs = wots_pkgen(pk, skseed, pkseed, adrs);

    // split live-range of the output parameters into two segments
    pk = pk; adrs = adrs;

    return pk, adrs;
}

/*-------------------------------------------------------------+
| ALGORITHM 7 FROM SLH-DSS (FIPS 205)                          |
| Generates a WOTS+ signature on an n-byte message.            |
+-------------------------------------------------------------*/
fn wots_sign(
    reg ptr u8[WOTS_SIG] sig_wots, // out: WOTS+ signature
    reg ptr u8[SPX_N] m,           // message to sign (XMSS tree root or FORS public key)
    reg ptr u8[SPX_N] skseed,      // SK.seed
    reg ptr u8[SPX_N] pkseed,      // PK.seed
    reg ptr u32[8] adrs            // ADRS
) -> reg ptr u8[WOTS_SIG], reg ptr u32[8] // -> sig_wots, adrs
{
    // stack variables
    stack u32[SPX_LEN] lengths; // indices indicating number of hash evaluations per chain
    stack u32[SPX_LEN] start;   // start position of every chain
    stack u32[8] skadrs;        // ADRS clone for computing WOTS+ secret key

    // register variables
    reg u32 kpa; // ADRS key pair address
    reg u32 pos; // temporary variable for setting the positions

    inline int j;

    // compute the chain lengths based on the message
    lengths = __chain_lengths(lengths, m);

    // clone ADRS and set the correct type for computing WOTS+ secret keys
    skadrs = __adrs_clone(skadrs, adrs);
    skadrs = __adrs_set_type_and_clear(skadrs, SPX_ADRS_TYPE_WOTS_PRF);

    // get the key pair address from ADRS, and set it in skADRS
    kpa = __adrs_get_key_pair_addr(adrs);
    skadrs = __adrs_set_key_pair_addr(skadrs, kpa);

    // compute all secret key values, four at a time
    () = #spill(adrs, pkseed);
    sig_wots = __wots_sk_x4(sig_wots, skseed, pkseed, skadrs);
    () = #unspill(adrs, pkseed);
    _ = #init_msf(); // the unspilled values are public after the fence

    // hash every chain from the secret key value (position 0) to the signature value (position lengths[j])
    pos = 0; for j=0 to SPX_LEN { start[j] = pos; }

    // compute all signature values, four chains at a time
    () = #spill(adrs);
    sig_wots = __wots_chains_x4(sig_wots, start, lengths, pkseed, adrs);
    () = #unspill(adrs);
    _ = #init_msf(); // the unspilled values are public after the fence

    return sig_wots, adrs;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __wots_sign(
    reg ptr u8[WOTS_SIG] sig_wots, // out: WOTS+ signature
    reg ptr u8[SPX_N] m,           // message to sign (XMSS tree root or FORS public key)
    reg ptr u8[SPX_N] skseed,      // SK.seed
    reg ptr u8[SPX_N] pkseed,      // PK.seed
    reg ptr u32[8] adrs            // ADRS
) -> reg ptr u8[WOTS_SIG], reg ptr u32[8] // -> sig_wots, adrs
{
    // split live-range of the parameters into two segments
    sig_wots = sig_wots; m = m; skseed = skseed; pkseed = pkseed; adrs = adrs;

    sig_wots, adrs = wots_sign(sig_wots, m, skseed, pkseed, adrs);

    // split live-range of the output parameters into two segments
    sig_wots = sig_wots; adrs = adrs;

    return sig_wots, adrs;
}

/*-------------------------------------------------------------+
| ALGORITHM 8 FROM SLH-DSS (FIPS 205)                          |
| Computes a WOTS+ public key from a message and its           |
| signature.                                                   |
+-------------------------------------------------------------*/
fn wots_pkfromsig(
    reg ptr u8[SPX_N] pk_wots,     // out: WOTS+ public key
    reg ptr u8[WOTS_SIG] sig_wots, // WOTS+ signature
    reg ptr u8[SPX_N] m,           // message (XMSS root or FORS public key)
    reg ptr u8[SPX_N] pkseed,      // PK.seed
    reg ptr u32[8] adrs            // ADRS
) -> reg ptr u8[SPX_N], reg ptr u32[8] // -> pk_wots, adrs
{
    () = #spill(pk_wots); // only needed at the end of this function

    // stack variables
    stack u32[SPX_LEN] lengths; // indices indicating number of hash evaluations per chain
    stack u32[SPX_LEN] stop;    // stop position of every chain
    stack u8[WOTS_SIG] sigvals; // all chain values concatenated
    stack u32[8] wotspkADRS;    // ADRS clone for computing the WOTS+ public key values

    // register variables
    reg u32 kpa; // ADRS key pair address
    reg u32 pos; // temporary variable for setting the positions

    inline int j;

    // compute the chain lengths based on the message
    lengths = __chain_lengths(lengths, m);

    // copy the WOTS+ signature into sigvals (as sig_wots is not writable)
    for j=0 to WOTS_SIG { sigvals[j] = sig_wots[j]; }

    // hash every chain from the signature value (position lengths[j]) to the public key value (position w-1)
    pos = SPX_W-1; for j=0 to SPX_LEN { stop[j] = pos; }

    // compute all public key values, four chains at a time
    () = #spill(adrs, pkseed);
    sigvals = __wots_chains_x4(sigvals, lengths, stop, pkseed, adrs);
    () = #unspill(adrs, pkseed);
    _ = #init_msf(); // the unspilled values are public after the fence

    // set the correct ADRS values for WOTS+ public key generation
    wotspkADRS = __adrs_clone(wotspkADRS, adrs);
    wotspkADRS = __adrs_set_type_and_clear(wotspkADRS, SPX_ADRS_TYPE_WOTS_PK);

    // get the key pair address from ADRS, and set it in wotspkADRS
    kpa = __adrs_get_key_pair_addr(adrs);
    wotspkADRS = __adrs_set_key_pair_addr(wotspkADRS, kpa);

    () = #unspill(pk_wots);
    _ = #init_msf(); // the unspilled values are public after the fence

    // compute the WOTS+ overall public key by hashing all public key chain values together
    () = #spill(adrs);
    pk_wots = __T_len(pk_wots, pkseed, wotspkADRS, sigvals);
    () = #unspill(adrs);
    _ = #init_msf(); // the unspilled values are public after the fence

    return pk_wots, adrs;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __wots_pkfromsig(
    reg ptr u8[SPX_N] pk_wots,     // out: WOTS+ public key
    reg ptr u8[WOTS_SIG] sig_wots, // WOTS+ signature
    reg ptr u8[SPX_N] m,           // message (XMSS root or FORS public key)
    reg ptr u8[SPX_N] pkseed,      // PK.seed
    reg ptr u32[8] adrs            // ADRS
) -> reg ptr u8[SPX_N], reg ptr u32[8] // -> pk_wots, adrs
{
    // split live-range of the parameters into two segments
    pk_wots = pk_wots; sig_wots = sig_wots; m = m; pkseed = pkseed; adrs = adrs;

    pk_wots, adrs = wots_pkfromsig(pk_wots, sig_wots, m, pkseed, adrs);

    // split live-range of the output parameters into two segments
    pk_wots = pk_wots; adrs = adrs;

    return pk_wots, adrs;
}