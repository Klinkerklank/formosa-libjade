/*
 * WOTS+ algorithms, using SHA-2 as a hash function
 * (which needs to be separate from SHAKE as we only use a cached state for SHA-2)
 *
 * author: Dennis op 't Roodt 2026-09-17 (d.n.e.o.t.roodt@tue.nl)
 */

// namespace for the base_w computation of the WOTS+ message parts
namespace baseb_wots_m {
  param int B      = SPX_W;
  param int LG_B   = SPX_LG_W;
  param int OUTLEN = SPX_LEN_1;
  param int INLEN  = SPX_N;
  require "../misc/baseb.jinc" // algorithm 4 of SLH-DSS: base_2^b
}

// namespace for the base_w computation of the WOTS+ checksum parts
namespace baseb_wots_c {
  param int B      = SPX_W;
  param int LG_B   = SPX_LG_W;
  param int OUTLEN = SPX_LEN_2;
  param int INLEN  = (SPX_LEN_2 * SPX_LG_W + 7) / 8;
  require "../misc/baseb.jinc" // algorithm 4 of SLH-DSS: base_2^b
}

/////////////////////// HELPER FUNCTIONS ///////////////////////

// checksum computation over the message parts
inline
fn __csum(
    reg ptr u32[SPX_LEN_1] msg // message input
) -> reg u32 // -> csum
{
    // register variables
    reg u32 csum; // checksum value

    inline int i;

    // resolve at compile time: sum_(i=0)^(len_1) w-1 = len_1 * (w-1)
    csum = SPX_LEN_1 * (SPX_W-1);

    // subtract the message parts to get sum_(i=0)^(len_1) w-1-msg[i]
    for i=0 to SPX_LEN_1 { csum -= msg[i]; }

    // the checksum is later converted into base-w digits by interpreting
    // its byte encoding from the most-significant bits first
    //
    // each base-w digit uses log(w) bits, so the total checksum bitlength is len_2*log(w)
    //
    // if this bitlength is not a multiple of 8, the checksum bits are not
    // correctly aligned to the start of the byte array
    //
    // there are len_2*log(w) mod 8 bits that are not correctly left-aligned
    // so we need to left-shift the csum value by (8-(len_2*log(w) mod 8)) mod 8 bits
    csum <<= ((8-((SPX_LEN_2*SPX_LG_W) % 8)) % 8); // all resolved at compile time

    return csum;
}

// compute for each chain how often its secret key value is
// iteratively hashed to obtain the WOTS+ signature values
inline
fn __chain_lengths(
    reg ptr u32[SPX_LEN] lengths, // out: chain lengths as integers
    reg ptr u8[SPX_N] msg         // message input
) -> reg ptr u32[SPX_LEN] // -> lengths
{
    // stack variables
    stack u8[(SPX_LEN_2 * SPX_LG_W + 7) / 8] csum_basew; // buffer for the checksum value as base-w bytes

    // register variables
    reg u32 csum;      // checksum value
    reg u32 csum_byte; // temporary variable for bitshifting and masking purposes

    inline int k;

    // compute the base-w message part indices
    lengths[0 : SPX_LEN_1] = baseb_wots_m::__base_b(lengths[0 : SPX_LEN_1], msg);

    // compute the checksum value
    csum = __csum(lengths[0 : SPX_LEN_1]);

    // convert the csum value into bytes, setting the least-significant bytes first
    for k=0 to (SPX_LEN_2 * SPX_LG_W + 7) / 8 {
        csum_byte = csum;  // copy the csum value
        csum_byte >>= k*8; // bitshift the next byte to the least-significant byte position
        csum_byte &= 0xFF; // compute mod 256
        csum_basew[((SPX_LEN_2 * SPX_LG_W + 7) / 8 - 1) - k] = (8u) csum_byte;
    }

    // compute the base-w checksum part indices, and append to the message part indices
    lengths[SPX_LEN_1 : SPX_LEN_2] = baseb_wots_c::__base_b(lengths[SPX_LEN_1 : SPX_LEN_2], csum_basew);

    return lengths;
}

//////////////////// PARALLELISED CHAINING /////////////////////
//
// F and PRF are SHA-256 for every SHA-2 parameter set (including n = 24, 32),
// over one 64-byte block holding PK.seed (the cached state) and one block for
// ADRS^c || M (22 + n <= 55 bytes, so the padding fits in that block).
// The chains of one WOTS+ instance are hashed eight at a time on the
// eight-lane AVX2 SHA-256. wots_chains_x8 (pkgen: all chains take the same
// steps) and wots_sk_x8 run the LEN chains as WOTS_X8_LANES lanes, the last
// batch padded with dummy lanes; wots_chains_refill_x8 (sign, pkFromSig:
// chains of different lengths) keeps every lane busy with the next chain.

param int WOTS_X8_LANES = ((SPX_LEN + 7) / 8) * 8; // LEN rounded up to a multiple of 8
param int WOTS_X8_BATCHES = WOTS_X8_LANES / 8;      // number of eight-lane batches

// broadcast the cached SHA-256 state (of PK.seed || toByte(0, 64-n)) to all eight lanes
inline
fn __sha256_x8_state_cache(
    reg ptr u256[sha256_parallel::STATE_WORD_SIZE] state_cache, // out: vectorised cached state
    reg ptr u8[96] h_cache                                      // cached SHA2 state(s)
) -> reg ptr u256[sha256_parallel::STATE_WORD_SIZE] // -> state_cache
{
    stack u32 state_word; // VPBROADCAST takes a memory operand
    reg u32 word;
    reg u256 vector;

    inline int i;

    for i=0 to sha256_parallel::STATE_WORD_SIZE {
        word = h_cache[:u32 i];
        state_word = word;
        vector = #VPBROADCAST_8u32(state_word);
        state_cache[i] = vector;
    }

    return state_cache;
}

// eight ADRS^c copies of adrs, one per lane; the chain and hash addresses of
// each copy are set per batch / per step by the callers
inline
fn __adrsc_x8(
    reg ptr u8[8*22] adrscs, // out: eight ADRS^c
    reg ptr u32[8] adrs      // ADRS
) -> reg ptr u8[8*22] // -> adrscs
{
    reg u8 byte;

    inline int i j;

    adrscs[0 : 22] = __adrs_compress(adrscs[0 : 22], adrs);
    for i=0 to 22 {
        byte = adrscs[i];
        for j=1 to 8 { adrscs[22*j + i] = byte; }
    }

    return adrscs;
}

// set the chain addresses of the eight lanes to 8*batch, ..., 8*batch + 7
inline
fn __adrsc_x8_set_chain_addr(
    reg ptr u8[8*22] adrscs, // eight ADRS^c
    reg u64 batch            // batch index
) -> reg ptr u8[8*22] // -> adrscs
{
    reg u32 chain;
    reg u32 swap;

    inline int j;

    chain = (32u) batch;
    chain <<= 3;
    for j=0 to 8 {
        swap = chain;
        swap += j;
        swap = #BSWAP_32(swap);
        adrscs.[:u32 22*j + 14] = swap; // ADRS^c bytes 14..17: chain address
    }

    return adrscs;
}

// set the hash address of all eight lanes
inline
fn __adrsc_x8_set_hash_addr(
    reg ptr u8[8*22] adrscs, // eight ADRS^c
    reg u32 hashaddr         // hash address
) -> reg ptr u8[8*22] // -> adrscs
{
    reg u32 swap;

    inline int j;

    swap = hashaddr;
    swap = #BSWAP_32(swap);
    for j=0 to 8 {
        adrscs.[:u32 22*j + 18] = swap; // ADRS^c bytes 18..21: hash address
    }

    return adrscs;
}

// set the tree indices of the eight lanes to first, ..., first + 7
inline
fn __adrsc_x8_set_tree_index(
    reg ptr u8[8*22] adrscs, // eight ADRS^c
    reg u32 first            // tree index of lane 0
) -> reg ptr u8[8*22] // -> adrscs
{
    reg u32 swap;

    inline int j;

    for j=0 to 8 {
        swap = first;
        swap += j;
        swap = #BSWAP_32(swap);
        adrscs.[:u32 22*j + 18] = swap; // ADRS^c bytes 18..21: tree index
    }

    return adrscs;
}

// eight F (or PRF) evaluations in parallel:
// out_j = Trunc_n(SHA-256(PK.seed || toByte(0,64-n) || ADRS^c_j || in_j)), j = 0..7
fn F_x8(
    #[spill_to_mmx] reg ptr u8[8*SPX_N] out,                   // out: eight n-byte outputs
    #[spill_to_mmx] reg ptr u8[8*SPX_N] in,                    // eight n-byte inputs
    reg ptr u8[8*22] adrscs,                                   // eight ADRS^c
    reg ptr u256[sha256_parallel::STATE_WORD_SIZE] state_cache // vectorised cached state
) -> reg ptr u8[8*SPX_N] // -> out
{
    // stack variables
    stack u256[sha256_parallel::STATE_WORD_SIZE] state; // vectorised state
    stack u256[sha256_parallel::ROUNDS_NUM] schedule;   // vectorised message schedule
    stack u8[SHA256_OUT] d0 d1 d2 d3 d4 d5 d6 d7;       // full digests

    // register variables
    reg u64 sch_idx; // byte index in the message schedule
    reg u64 bits;    // number of bits processed

    () = #spill(out);

    // start from the cached state: one block (PK.seed || padding) is consumed
    sch_idx = 0;
    bits = SHA256_IN*8;
    state, schedule, sch_idx, bits = sha256_parallel::init_cache(state, schedule, sch_idx, bits, state_cache);

    // absorb ADRS^c of every lane
    () = #spill(in);
    state, schedule, sch_idx, bits = sha256_parallel_adrsc::absorb_fixed(state, schedule, sch_idx, bits,
        adrscs[0*22 : 22], adrscs[1*22 : 22], adrscs[2*22 : 22], adrscs[3*22 : 22],
        adrscs[4*22 : 22], adrscs[5*22 : 22], adrscs[6*22 : 22], adrscs[7*22 : 22]);
    () = #unspill(in);

    // absorb the n-byte input of every lane
    state, schedule, sch_idx, bits = sha256_parallel_n::absorb_fixed(state, schedule, sch_idx, bits,
        in[0*SPX_N : SPX_N], in[1*SPX_N : SPX_N], in[2*SPX_N : SPX_N], in[3*SPX_N : SPX_N],
        in[4*SPX_N : SPX_N], in[5*SPX_N : SPX_N], in[6*SPX_N : SPX_N], in[7*SPX_N : SPX_N]);

    // pad and compress
    schedule, d0, d1, d2, d3, d4, d5, d6, d7 = sha256_parallel::finalise(state, schedule, sch_idx, bits, d0, d1, d2, d3, d4, d5, d6, d7);

    () = #unspill(out);

    // truncate to n bytes
    out[0*SPX_N : SPX_N] = __copy_nbytes(out[0*SPX_N : SPX_N], d0[0 : SPX_N]);
    out[1*SPX_N : SPX_N] = __copy_nbytes(out[1*SPX_N : SPX_N], d1[0 : SPX_N]);
    out[2*SPX_N : SPX_N] = __copy_nbytes(out[2*SPX_N : SPX_N], d2[0 : SPX_N]);
    out[3*SPX_N : SPX_N] = __copy_nbytes(out[3*SPX_N : SPX_N], d3[0 : SPX_N]);
    out[4*SPX_N : SPX_N] = __copy_nbytes(out[4*SPX_N : SPX_N], d4[0 : SPX_N]);
    out[5*SPX_N : SPX_N] = __copy_nbytes(out[5*SPX_N : SPX_N], d5[0 : SPX_N]);
    out[6*SPX_N : SPX_N] = __copy_nbytes(out[6*SPX_N : SPX_N], d6[0 : SPX_N]);
    out[7*SPX_N : SPX_N] = __copy_nbytes(out[7*SPX_N : SPX_N], d7[0 : SPX_N]);

    return out;
}

/*-------------------------------------------------------------+
| ALGORITHM 5 FROM SLH-DSS (FIPS 205), ALL CHAINS AT ONCE      |
| (batches: for chains that all take the same steps, pkgen)    |
| Advances every chain j of a WOTS+ instance from position     |
| start[j] to position stop[j], eight chains at a time.        |
| The eight lanes of a batch step together from the smallest   |
| start to the largest stop of the batch; a lane only takes    |
| the new value while start[j] <= pos < stop[j]. The positions |
| are public (they follow from the message), the selection is  |
| branch-free.                                                 |
+-------------------------------------------------------------*/
fn wots_chains_x8(
    reg ptr u8[WOTS_SIG] chains,         // in/out: the LEN chain values
    reg ptr u32[SPX_LEN] start,          // start position of every chain
    reg ptr u32[SPX_LEN] stop,           // stop position of every chain
    reg ptr u32[8] adrs,                 // ADRS (type WOTS_HASH, key pair address set)
    reg ptr u8[96] h_cache               // cached SHA2 state(s)
) -> reg ptr u8[WOTS_SIG] // -> chains
{
    // stack variables
    stack u8[WOTS_X8_LANES*SPX_N] work;                       // chain values, padded to whole batches
    stack u8[8*SPX_N] next;                                   // the hashes of one step of a batch
    stack u8[8*22] adrscs;                                    // ADRS^c of every lane
    stack u256[sha256_parallel::STATE_WORD_SIZE] state_cache; // vectorised cached state
    stack u32[WOTS_X8_LANES] st;                              // start positions (dummy lanes: 0)
    stack u32[WOTS_X8_LANES] len;                             // number of steps (dummy lanes: 0)

    // register variables
    reg ptr u8[8*SPX_N] lanes; // pointer to the chain values of the current batch
    reg u64 batch;             // batch index
    reg u64 boff;              // byte offset of the batch in work
    reg u64 lane;              // lane index in st, len
    reg u32 pos;               // current position in the chains
    reg u32 hi;                // largest stop position of the batch
    reg u32 s;                 // start position of a lane
    reg u32 l;                 // number of steps of a lane
    reg u32 e;                 // stop position of a lane
    reg u32 d;                // steps of a lane already taken at pos
    reg u32 big;               // larger than every position
    reg u32 zero;
    reg u64 x y;               // temporary variables for copying

    inline int i j;

    () = #spill(chains);

    // per-lane start positions and step counts
    zero = 0;
    for i=0 to SPX_LEN {
        s = start[i];
        st[i] = s;
        l = stop[i];
        l -= s;
        len[i] = l;
    }
    for i=SPX_LEN to WOTS_X8_LANES {
        st[i] = zero;
        len[i] = zero;
    }

    // the chain values, padded with (unused) dummy lanes
    () = #unspill(chains);
    for i=0 to WOTS_SIG/8 {
        x = chains.[:u64 8*i];
        work.[:u64 8*i] = x;
    }
    for i=WOTS_SIG/8 to WOTS_X8_LANES*SPX_N/8 {
        work.[:u64 8*i] = 0;
    }

    state_cache = __sha256_x8_state_cache(state_cache, h_cache);
    adrscs = __adrsc_x8(adrscs, adrs);

    batch = 0;
    while (batch < WOTS_X8_BATCHES) {
        adrscs = __adrsc_x8_set_chain_addr(adrscs, batch);

        // pos = smallest start, hi = largest stop, over the lanes with steps to take
        pos = SPX_W;
        hi = 0;
        zero = 0;
        lane = batch;
        lane <<= 3;
        for j=0 to 8 {
            s = st[lane + j];
            l = len[lane + j];
            e = s;
            e += l;
            big = SPX_W;
            s = big if (l == 0);  // a lane without steps neither lowers pos ...
            e = zero if (l == 0); // ... nor raises hi
            pos = s if (s < pos);
            hi = e if (hi < e);
        }
        _ = #init_msf(); // the positions follow from public values; public after the fence

        boff = batch;
        boff *= 8*SPX_N;

        while (pos < hi) {
            () = #spill(batch, boff, pos, hi);

            adrscs = __adrsc_x8_set_hash_addr(adrscs, pos);

            // hash one step of all eight lanes
            lanes = work[boff : 8*SPX_N];
            next = F_x8(next, lanes, adrscs, state_cache);
            work[boff : 8*SPX_N] = lanes;

            () = #unspill(batch, boff, pos, hi);
            _ = #init_msf(); // the unspilled values are public after the fence

            // keep the new value of the lanes with start <= pos < start + len,
            // i.e. (pos - start) < len, unsigned
            lane = batch;
            lane <<= 3;
            for j=0 to 8 {
                d = pos;
                s = st[lane + j];
                d -= s;
                l = len[lane + j];
                for i=0 to SPX_N/8 {
                    x = work.[:u64 boff + j*SPX_N + 8*i];
                    y = next.[:u64 j*SPX_N + 8*i];
                    x = y if (d < l);
                    work.[:u64 boff + j*SPX_N + 8*i] = x;
                }
            }

            pos += 1;
        }

        batch += 1;
    }

    // write back the LEN real lanes
    () = #unspill(chains);
    _ = #init_msf(); // the unspilled pointer is public after the fence
    for i=0 to WOTS_SIG/8 {
        x = work.[:u64 8*i];
        chains.[:u64 8*i] = x;
    }

    return chains;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __wots_chains_x8(
    reg ptr u8[WOTS_SIG] chains,
    reg ptr u32[SPX_LEN] start,
    reg ptr u32[SPX_LEN] stop,
    reg ptr u32[8] adrs,
    reg ptr u8[96] h_cache
) -> reg ptr u8[WOTS_SIG] // -> chains
{
    chains = chains; start = start; stop = stop; adrs = adrs; h_cache = h_cache;

    chains = wots_chains_x8(chains, start, stop, adrs, h_cache);

    chains = chains;

    return chains;
}

/*-------------------------------------------------------------+
| ALGORITHM 5 FROM SLH-DSS (FIPS 205), ALL CHAINS AT ONCE      |
| (refilled lanes: for chains of different lengths, sign and   |
| pkFromSig)                                                   |
| Advances every chain j of a WOTS+ instance from position     |
| start[j] to position stop[j] on eight lanes. Each lane holds |
| one chain at its own position; when its chain reaches its    |
| stop, the lane takes the next chain with steps to take, so   |
| the lanes stay busy whatever the positions. The positions    |
| are public (they follow from the message); the lanes are     |
| updated without branches, and the chain indices loaded from  |
| memory are protected with the misspeculation flag.           |
+-------------------------------------------------------------*/
fn wots_chains_refill_x8(
    reg ptr u8[WOTS_SIG] chains, // in/out: the LEN chain values
    reg ptr u32[SPX_LEN] start,  // start position of every chain
    reg ptr u32[SPX_LEN] stop,   // stop position of every chain
    reg ptr u32[8] adrs,         // ADRS (type WOTS_HASH, key pair address set)
    reg ptr u8[96] h_cache       // cached SHA2 state(s)
) -> reg ptr u8[WOTS_SIG] // -> chains
{
    // stack variables
    stack u8[(SPX_LEN+1)*SPX_N] work;                         // chain values, and the dummy chain SPX_LEN
    stack u8[8*SPX_N] cur;                                    // the value of every lane
    stack u8[8*SPX_N] next;                                   // the hashes of one step of the lanes
    stack u8[8*22] adrscs;                                    // ADRS^c of every lane
    stack u256[sha256_parallel::STATE_WORD_SIZE] state_cache; // vectorised cached state
    stack u32[SPX_LEN+1] st;                                  // start position of every chain (dummy: 0)
    stack u32[SPX_LEN+1] en;                                  // stop position of every chain (dummy: 0)
    stack u32[SPX_LEN+1] queue;                               // the chains with steps to take, in order
    stack u32[8] lpos;                                        // position of every lane
    stack u32[8] lstop;                                       // stop position of every lane
    stack u32[8] lchain;                                      // chain of every lane
    stack u32 q_s;                                            // queue index of the next chain to take
    stack u32 nq_s;                                           // number of chains in the queue

    // register variables
    #[msf] reg u64 ms;     // misspeculation flag
    reg u32 p;             // position of a lane
    reg u32 e;             // stop position of a lane
    reg u32 c;             // chain of a lane
    reg u32 nc;            // next chain of the queue
    reg u32 s;             // start position of a chain
    reg u32 q;             // queue index of the next chain to take
    reg u32 nq;            // number of chains in the queue
    reg u32 one;
    reg u32 go;            // 1 when a lane takes the next chain
    reg u32 avail;         // 1 when the queue has a chain left
    reg u32 busy;          // 1 when a lane has a step to take
    reg u32 act;           // number of lanes with a step to take
    reg u32 swap;          // byte-swapped ADRS word
    reg u64 off;           // byte offset of a chain in work
    reg u64 idx;           // array index
    reg u64 x y;           // temporary variables for copying

    inline int i j w;

    () = #spill(chains);
    ms = #init_msf();

    // the start and stop positions of the chains, and the queue of the
    // chains with steps to take (a chain without steps keeps its value);
    // the queue entries after the last chain are the dummy chain, as the
    // lanes read the next entry of the queue even when it is empty
    for i=0 to SPX_LEN+1 { queue[i] = SPX_LEN; }
    nq = 0;
    one = 1;
    for i=0 to SPX_LEN {
        s = start[i];
        st[i] = s;
        e = stop[i];
        en[i] = e;
        idx = (64u) nq;
        queue[idx] = i;
        busy = 0;
        busy = one if (s < e);
        nq += busy;
        nq = #protect_32(nq, ms);
    }
    st[SPX_LEN] = 0;
    en[SPX_LEN] = 0;
    nq_s = nq;
    q_s = 0;

    // the chain values, and the dummy chain
    () = #unspill(chains);
    for i=0 to WOTS_SIG/8 {
        x = chains.[:u64 8*i];
        work.[:u64 8*i] = x;
    }
    for i=WOTS_SIG/8 to (SPX_LEN+1)*SPX_N/8 {
        work.[:u64 8*i] = 0;
    }

    // the lanes start empty, on the dummy chain
    for j=0 to 8 {
        lpos[j] = 0;
        lstop[j] = 0;
        lchain[j] = SPX_LEN;
        for w=0 to SPX_N/8 {
            cur.[:u64 j*SPX_N + 8*w] = 0;
            next.[:u64 j*SPX_N + 8*w] = 0;
        }
    }

    state_cache = __sha256_x8_state_cache(state_cache, h_cache);
    adrscs = __adrsc_x8(adrscs, adrs);

    while {
        // update every lane after a step (or, the first time, fill the lanes)
        q = q_s;
        nq = nq_s;
        act = 0;
        one = 1;
        for j=0 to 8 {
            p = lpos[j];
            e = lstop[j];
            c = lchain[j];
            c = #protect_32(c, ms);

            // a lane with a step to take takes its new value and advances
            for w=0 to SPX_N/8 {
                x = cur.[:u64 j*SPX_N + 8*w];
                y = next.[:u64 j*SPX_N + 8*w];
                x = y if (p < e);
                cur.[:u64 j*SPX_N + 8*w] = x;
            }
            busy = 0;
            busy = one if (p < e);
            p += busy;

            // write the value of the lane back to its chain
            off = (64u) c;
            off *= SPX_N;
            for w=0 to SPX_N/8 {
                x = cur.[:u64 j*SPX_N + 8*w];
                work.[:u64 off + 8*w] = x;
            }

            // a lane at the stop of its chain takes the next chain of the queue
            go = 0;
            go = one if (p == e);
            avail = 0;
            avail = one if (q < nq);
            go &= avail;
            q = #protect_32(q, ms);
            idx = (64u) q;
            nc = queue[idx];
            nc = #protect_32(nc, ms);
            c = nc if (go != 0);
            idx = (64u) nc;
            s = st[idx];
            p = s if (go != 0);
            s = en[idx];
            e = s if (go != 0);
            off = (64u) nc;
            off *= SPX_N;
            for w=0 to SPX_N/8 {
                x = cur.[:u64 j*SPX_N + 8*w];
                y = work.[:u64 off + 8*w];
                x = y if (go != 0);
                cur.[:u64 j*SPX_N + 8*w] = x;
            }
            q += go;

            lpos[j] = p;
            lstop[j] = e;
            lchain[j] = c;

            busy = 0;
            busy = one if (p < e);
            act += busy;
        }
        q_s = q;
        act = #protect_32(act, ms);
    } (act != 0) {
        // the chain and hash address of every lane
        for j=0 to 8 {
            swap = lchain[j];
            swap = #BSWAP_32(swap);
            adrscs.[:u32 22*j + 14] = swap; // ADRS^c bytes 14..17: chain address
            swap = lpos[j];
            swap = #BSWAP_32(swap);
            adrscs.[:u32 22*j + 18] = swap; // ADRS^c bytes 18..21: hash address
        }

        // one step of every lane
        next = F_x8(next, cur, adrscs, state_cache);
        ms = #init_msf(); // a fresh misspeculation flag after the call
    }

    // write back the LEN chains
    () = #unspill(chains);
    _ = #init_msf(); // the unspilled pointer is public after the fence
    for i=0 to WOTS_SIG/8 {
        x = work.[:u64 8*i];
        chains.[:u64 8*i] = x;
    }

    return chains;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __wots_chains_refill_x8(
    reg ptr u8[WOTS_SIG] chains,
    reg ptr u32[SPX_LEN] start,
    reg ptr u32[SPX_LEN] stop,
    reg ptr u32[8] adrs,
    reg ptr u8[96] h_cache
) -> reg ptr u8[WOTS_SIG] // -> chains
{
    chains = chains; start = start; stop = stop; adrs = adrs; h_cache = h_cache;

    chains = wots_chains_refill_x8(chains, start, stop, adrs, h_cache);

    chains = chains;

    return chains;
}

// the LEN WOTS+ secret key values sk_j = PRF(PK.seed, SK.seed, skADRS_j), eight at a time
fn wots_sk_x8(
    reg ptr u8[WOTS_SIG] chains, // out: the LEN secret key values
    reg ptr u8[SPX_N] skseed,    // SK.seed
    reg ptr u32[8] skadrs,       // skADRS (type WOTS_PRF, key pair address set)
    reg ptr u8[96] h_cache       // cached SHA2 state(s)
) -> reg ptr u8[WOTS_SIG] // -> chains
{
    // stack variables
    stack u8[WOTS_X8_LANES*SPX_N] work;                       // secret key values, padded to whole batches
    stack u8[8*SPX_N] seeds;                                  // SK.seed in every lane
    stack u8[8*22] adrscs;                                    // ADRS^c of every lane
    stack u256[sha256_parallel::STATE_WORD_SIZE] state_cache; // vectorised cached state

    // register variables
    reg ptr u8[8*SPX_N] lanes; // pointer to the values of the current batch
    reg u64 batch;             // batch index
    reg u64 boff;              // byte offset of the batch in work
    reg u64 x;                 // temporary variable for copying

    inline int i j;

    () = #spill(chains);

    for j=0 to 8 {
        seeds[j*SPX_N : SPX_N] = __copy_nbytes(seeds[j*SPX_N : SPX_N], skseed);
    }

    state_cache = __sha256_x8_state_cache(state_cache, h_cache);
    adrscs = __adrsc_x8(adrscs, skadrs); // hash address 0

    batch = 0;
    while (batch < WOTS_X8_BATCHES) {
        adrscs = __adrsc_x8_set_chain_addr(adrscs, batch);

        boff = batch;
        boff *= 8*SPX_N;

        () = #spill(batch, boff);
        lanes = work[boff : 8*SPX_N];
        lanes = F_x8(lanes, seeds, adrscs, state_cache);
        () = #unspill(batch, boff);
        _ = #init_msf(); // the unspilled values are public after the fence
        work[boff : 8*SPX_N] = lanes;

        batch += 1;
    }

    () = #unspill(chains);
    _ = #init_msf(); // the unspilled pointer is public after the fence
    for i=0 to WOTS_SIG/8 {
        x = work.[:u64 8*i];
        chains.[:u64 8*i] = x;
    }

    return chains;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __wots_sk_x8(
    reg ptr u8[WOTS_SIG] chains,
    reg ptr u8[SPX_N] skseed,
    reg ptr u32[8] skadrs,
    reg ptr u8[96] h_cache
) -> reg ptr u8[WOTS_SIG] // -> chains
{
    chains = chains; skseed = skseed; skadrs = skadrs; h_cache = h_cache;

    chains = wots_sk_x8(chains, skseed, skadrs, h_cache);

    chains = chains;

    return chains;
}

//////////////////////// MAIN FUNCTIONS ////////////////////////

/*-------------------------------------------------------------+
| ALGORITHM 6 FROM SLH-DSS (FIPS 205)                          |
| Generates a WOTS+ public key.                                |
+-------------------------------------------------------------*/
fn wots_pkgen(
    reg ptr u8[SPX_N] pk,     // out: WOTS+ public key
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg ptr u32[8] adrs,      // ADRS
    reg ptr u8[96] cache_single    // cached SHA2 state
) -> reg ptr u8[SPX_N], reg ptr u32[8] // -> pk, adrs
{
    () = #spill(pk); // not needed until the end of the function

    // stack variables
    stack u32[8] adrs_key;      // ADRS clone for computing the WOTS+ secret and public key values
    stack u8[WOTS_SIG] chains;  // all chain values concatenated
    stack u32[SPX_LEN] start;   // start position of every chain
    stack u32[SPX_LEN] stop;    // stop position of every chain

    // register variables
    reg u32 kpa; // ADRS key pair address
    reg u32 pos; // temporary variable for setting the positions

    inline int j;

    // clone ADRS (adrs_key here is what the SLH-DSS calls skADRS),
    // and set the correct type for computing WOTS+ secret keys
    adrs_key = __adrs_clone(adrs_key, adrs);
    adrs_key = __adrs_set_type_and_clear(adrs_key, SPX_ADRS_TYPE_WOTS_PRF);

    // get the key pair address from ADRS, and set it in adrs_key
    kpa = __adrs_get_key_pair_addr(adrs);
    adrs_key = __adrs_set_key_pair_addr(adrs_key, kpa);

    // compute all secret key values, eight at a time
    () = #spill(adrs, cache_single);
    chains = __wots_sk_x8(chains, skseed, adrs_key, cache_single);
    () = #unspill(adrs, cache_single);
    _ = #init_msf(); // the unspilled values are public after the fence

    // hash every chain from the secret key value (position 0) to the public key value (position w-1)
    pos = 0;       for j=0 to SPX_LEN { start[j] = pos; }
    pos = SPX_W-1; for j=0 to SPX_LEN { stop[j]  = pos; }

    // compute all public key values, eight chains at a time
    () = #spill(adrs, cache_single);
    chains = __wots_chains_x8(chains, start, stop, adrs, cache_single);
    () = #unspill(adrs, cache_single);
    _ = #init_msf(); // the unspilled values are public after the fence

    // adrs_key now becomes wotspkADRS (to avoid an ADRS clone)
    adrs_key = __adrs_set_type_and_clear(adrs_key, SPX_ADRS_TYPE_WOTS_PK);
    kpa = __adrs_get_key_pair_addr(adrs);
    adrs_key = __adrs_set_key_pair_addr(adrs_key, kpa);

    () = #unspill(pk);
    _ = #init_msf(); // the unspilled values are public after the fence

    // compute the WOTS+ overall public key by hashing all public key chain values together
    () = #spill(adrs);
    pk = __T_len(pk, adrs_key, chains, cache_single);
    () = #unspill(adrs);
    _ = #init_msf(); // the unspilled values are public after the fence

    return pk, adrs;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __wots_pkgen(
    reg ptr u8[SPX_N] pk,     // out: WOTS+ public key
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg ptr u32[8] adrs,      // ADRS
    reg ptr u8[96] cache_single    // cached SHA2 state
) -> reg ptr u8[SPX_N], reg ptr u32[8] // -> pk, adrs
{
    // split live-range of the parameters into two segments
    pk = pk; skseed = skseed; adrs = adrs; cache_single = cache_single;

    pk, adrs = wots_pkgen(pk, skseed, adrs, cache_single);

    // split live-range of the output parameters into two segments
    pk = pk; adrs = adrs;

    return pk, adrs;
}

/*-------------------------------------------------------------+
| ALGORITHM 7 FROM SLH-DSS (FIPS 205)                          |
| Generates a WOTS+ signature on an n-byte message.            |
+-------------------------------------------------------------*/
fn wots_sign(
    reg ptr u8[WOTS_SIG] sig_wots, // out: WOTS+ signature
    reg ptr u8[SPX_N] m,           // message to sign (XMSS tree root or FORS public key)
    reg ptr u8[SPX_N] skseed,      // SK.seed
    reg ptr u32[8] adrs,           // ADRS
    reg ptr u8[96] cache_single         // cached SHA2 state
) -> reg ptr u8[WOTS_SIG], reg ptr u32[8] // -> sig_wots, adrs
{
    // stack variables
    stack u32[SPX_LEN] lengths; // indices indicating number of hash evaluations per chain
    stack u32[SPX_LEN] start;   // start position of every chain
    stack u32[8] skadrs;        // ADRS clone for computing WOTS+ secret key

    // register variables
    reg u32 kpa; // ADRS key pair address
    reg u32 pos; // temporary variable for setting the positions

    inline int j;

    // compute the chain lengths based on the message
    lengths = __chain_lengths(lengths, m);

    // clone ADRS and set the correct type for computing WOTS+ secret keys
    skadrs = __adrs_clone(skadrs, adrs);
    skadrs = __adrs_set_type_and_clear(skadrs, SPX_ADRS_TYPE_WOTS_PRF);

    // get the key pair address from ADRS, and set it in skADRS
    kpa = __adrs_get_key_pair_addr(adrs);
    skadrs = __adrs_set_key_pair_addr(skadrs, kpa);

    // compute all secret key values, eight at a time
    () = #spill(adrs, cache_single);
    sig_wots = __wots_sk_x8(sig_wots, skseed, skadrs, cache_single);
    () = #unspill(adrs, cache_single);
    _ = #init_msf(); // the unspilled values are public after the fence

    // hash every chain from the secret key value (position 0) to the signature value (position lengths[j])
    pos = 0; for j=0 to SPX_LEN { start[j] = pos; }

    // compute all signature values, eight chains at a time
    () = #spill(adrs);
    sig_wots = __wots_chains_refill_x8(sig_wots, start, lengths, adrs, cache_single);
    () = #unspill(adrs);
    _ = #init_msf(); // the unspilled values are public after the fence

    return sig_wots, adrs;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __wots_sign(
    reg ptr u8[WOTS_SIG] sig_wots, // out: WOTS+ signature
    reg ptr u8[SPX_N] m,           // message to sign (XMSS tree root or FORS public key)
    reg ptr u8[SPX_N] skseed,      // SK.seed
    reg ptr u32[8] adrs,           // ADRS
    reg ptr u8[96] cache_single         // cached SHA2 state
) -> reg ptr u8[WOTS_SIG], reg ptr u32[8] // -> sig_wots, adrs
{
    // split live-range of the parameters into two segments
    sig_wots = sig_wots; m = m; skseed = skseed; adrs = adrs; cache_single = cache_single;

    sig_wots, adrs = wots_sign(sig_wots, m, skseed, adrs, cache_single);

    // split live-range of the output parameters into two segments
    sig_wots = sig_wots; adrs = adrs;

    return sig_wots, adrs;
}

/*-------------------------------------------------------------+
| ALGORITHM 8 FROM SLH-DSS (FIPS 205)                          |
| Computes a WOTS+ public key from a message and its           |
| signature.                                                   |
+-------------------------------------------------------------*/
fn wots_pkfromsig(
    reg ptr u8[SPX_N] pk_wots,     // out: WOTS+ public key
    reg ptr u8[WOTS_SIG] sig_wots, // WOTS+ signature
    reg ptr u8[SPX_N] m,           // message (XMSS root or FORS public key)
    reg ptr u32[8] adrs,           // ADRS
    reg ptr u8[96] cache_single         // cached SHA2 state
) -> reg ptr u8[SPX_N], reg ptr u32[8] // -> pk_wots, adrs
{
    () = #spill(pk_wots); // only needed at the end of this function

    // stack variables
    stack u32[SPX_LEN] lengths; // indices indicating number of hash evaluations per chain
    stack u32[SPX_LEN] stop;    // stop position of every chain
    stack u8[WOTS_SIG] sigvals; // all chain values concatenated
    stack u32[8] wotspkADRS;    // ADRS clone for computing the WOTS+ public key values

    // register variables
    reg u32 kpa; // ADRS key pair address
    reg u32 pos; // temporary variable for setting the positions

    inline int j;

    // compute the chain lengths based on the message
    lengths = __chain_lengths(lengths, m);

    // copy the WOTS+ signature into sigvals (as sig_wots is not writable)
    for j=0 to WOTS_SIG { sigvals[j] = sig_wots[j]; }

    // hash every chain from the signature value (position lengths[j]) to the public key value (position w-1)
    pos = SPX_W-1; for j=0 to SPX_LEN { stop[j] = pos; }

    // compute all public key values, eight chains at a time
    () = #spill(adrs, cache_single);
    sigvals = __wots_chains_refill_x8(sigvals, lengths, stop, adrs, cache_single);
    () = #unspill(adrs, cache_single);
    _ = #init_msf(); // the unspilled values are public after the fence

    // set the correct ADRS values for WOTS+ public key generation
    wotspkADRS = __adrs_clone(wotspkADRS, adrs);
    wotspkADRS = __adrs_set_type_and_clear(wotspkADRS, SPX_ADRS_TYPE_WOTS_PK);

    // get the key pair address from ADRS, and set it in wotspkADRS
    kpa = __adrs_get_key_pair_addr(adrs);
    wotspkADRS = __adrs_set_key_pair_addr(wotspkADRS, kpa);

    () = #unspill(pk_wots);
    _ = #init_msf(); // the unspilled values are public after the fence

    // compute the WOTS+ overall public key by hashing all public key chain values together
    () = #spill(adrs);
    pk_wots = __T_len(pk_wots, wotspkADRS, sigvals, cache_single);
    () = #unspill(adrs);
    _ = #init_msf(); // the unspilled values are public after the fence

    return pk_wots, adrs;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __wots_pkfromsig(
    reg ptr u8[SPX_N] pk_wots,     // out: WOTS+ public key
    reg ptr u8[WOTS_SIG] sig_wots, // WOTS+ signature
    reg ptr u8[SPX_N] m,           // message (XMSS root or FORS public key)
    reg ptr u32[8] adrs,           // ADRS
    reg ptr u8[96] cache_single         // cached SHA2 state
) -> reg ptr u8[SPX_N], reg ptr u32[8] // -> pk_wots, adrs
{
    // split live-range of the parameters into two segments
    pk_wots = pk_wots; sig_wots = sig_wots; m = m; adrs = adrs; cache_single = cache_single;

    pk_wots, adrs = wots_pkfromsig(pk_wots, sig_wots, m, adrs, cache_single);

    // split live-range of the output parameters into two segments
    pk_wots = pk_wots; adrs = adrs;

    return pk_wots, adrs;
}
