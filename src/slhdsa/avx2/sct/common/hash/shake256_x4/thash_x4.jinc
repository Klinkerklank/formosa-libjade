/*
 * four tweakable hashes (F, PRF, H) at once on the four-way AVX2 Keccak:
 *
 *   out_l = SHAKE256(PK.seed || ADRS_l || M_l, 8n),  l = 0..3,
 *
 * where ADRS_l is ADRS with its words 6 and 7 (chain and hash address, or
 * tree height and tree index) replaced by w67[2l] and w67[2l+1], and (KP = 1)
 * its word 5 (key pair address) by w67[8+l], and M_l is in[l*MLEN : MLEN].
 * The input is at most n + 32 + 2n <= 128 bytes, so each lane is a single
 * block of the 136-byte rate: the padded block is built directly as the
 * four-way state, one 256-bit word (the same u64 word of the four lanes) at a
 * time, and one permutation follows.
 *
 * Needs to be included in a namespace that defines MLEN, the byte length of M,
 * and KP, whether the key pair address is per lane.
 */

// byte-swaps every 32-bit word: ADRS words are big-endian in the hash input
u256 THASH_X4_BSWAP32 = (8u32)[
    0x0c0d0e0f, 0x08090a0b, 0x04050607, 0x00010203,
    0x0c0d0e0f, 0x08090a0b, 0x04050607, 0x00010203];

// from four 32-bit words k0..k3 in both 128-bit halves: byte-swapped k_l in
// the upper half of 64-bit word l (the lower halves are blended away)
u256 THASH_X4_KP = (8u32)[
    0x0c0d0e0f, 0x80808080, 0x08090a0b, 0x80808080,
    0x04050607, 0x80808080, 0x00010203, 0x80808080];

// SHAKE padding: 0x1F right after the input, 0x80 in the last byte of the block
u256 THASH_X4_PAD_1F = (4u64)[0x1F, 0x1F, 0x1F, 0x1F];
u256 THASH_X4_PAD_80 = (4u64)[0x8000000000000000, 0x8000000000000000, 0x8000000000000000, 0x8000000000000000];
u256 THASH_X4_PAD_9F = (4u64)[0x800000000000001F, 0x800000000000001F, 0x800000000000001F, 0x800000000000001F];

param int THASH_X4_PADW = (SPX_N + 32 + MLEN) / 8; // u64 word of the 0x1F padding byte

// (inline, so that thash_x4_io can pass the same array as out and in: the
// whole input is in the state before the output is written)
inline
fn __thash_x4(
    #[spill_to_mmx] reg ptr u8[4*SPX_N] out, // output: four n-byte hashes
    reg ptr u8[4*MLEN] in,                   // four MLEN-byte messages, concatenated
    reg ptr u8[SPX_N] pkseed,                // PK.seed
    reg ptr u32[8] adrs,                     // ADRS (words 0..5 shared by the lanes)
    reg ptr u32[4*(2+KP)] w67                // ADRS words 6 and 7 (KP = 1: 5, 6 and 7) of every lane
) -> reg ptr u8[4*SPX_N] // -> out
{
    // stack variables
    stack u256[25] st; // four-way Keccak state: word k of lane l is st[:u64 4*k + l]

    // register variables
    reg u256 v;     // a state word (the same u64 word of the four lanes)
    reg u256 a;     // ADRS, as bytes
    reg u256 kpv;   // key pair addresses (KP = 1)
    reg u128 lo hi; // lanes 0, 1 and lanes 2, 3 of an input word
    reg u64 t;      // temporary variable for copying

    inline int k l;

    () = #spill(out);

    // PK.seed, in every lane (u64 words 0 .. n/8-1)
    for k=0 to SPX_N/8 {
        v = #VPBROADCAST_4u64(pkseed.[:u64 8*k]);
        st[k] = v;
    }

    // ADRS words 0..5 (big-endian), in every lane (u64 words n/8 .. n/8+2);
    // with KP = 1 the upper half of word n/8+2 (ADRS word 5) per lane
    a = adrs.[:u256 0];
    a = #VPSHUFB_256(a, THASH_X4_BSWAP32);
    v = #VPERMQ(a, (4u2)[0,0,0,0]);
    st[SPX_N/8] = v;
    v = #VPERMQ(a, (4u2)[1,1,1,1]);
    st[SPX_N/8 + 1] = v;
    v = #VPERMQ(a, (4u2)[2,2,2,2]);
    if (KP == 1) {
        kpv = #VPBROADCAST_2u128(w67.[:u128 32]);
        kpv = #VPSHUFB_256(kpv, THASH_X4_KP);
        v = #VPBLEND_8u32(v, kpv, 0xAA);
    }
    st[SPX_N/8 + 2] = v;

    // ADRS words 6 and 7, per lane (u64 word n/8+3)
    v = w67.[:u256 0];
    v = #VPSHUFB_256(v, THASH_X4_BSWAP32);
    st[SPX_N/8 + 3] = v;

    // M, per lane (u64 words n/8+4 ..), transposed into the state words
    for k=0 to MLEN/8 {
        t = in.[:u64 0*MLEN + 8*k];
        lo = #VMOV_64(t);
        t = in.[:u64 1*MLEN + 8*k];
        lo = #VPINSR_2u64(lo, t, 1);
        t = in.[:u64 2*MLEN + 8*k];
        hi = #VMOV_64(t);
        t = in.[:u64 3*MLEN + 8*k];
        hi = #VPINSR_2u64(hi, t, 1);
        v = (256u) lo;
        v = #VINSERTI128(v, hi, 1);
        st[SPX_N/8 + 4 + k] = v;
    }

    // the padding, and zero in the rest of the block and in the capacity
    if (THASH_X4_PADW == SHAKE256_RATE/8 - 1) {
        v = THASH_X4_PAD_9F;
        st[THASH_X4_PADW] = v;
    } else {
        v = THASH_X4_PAD_1F;
        st[THASH_X4_PADW] = v;
        v = THASH_X4_PAD_80;
        st[SHAKE256_RATE/8 - 1] = v;
    }
    v = #set0_256();
    for k=THASH_X4_PADW+1 to 25 {
        if (k != SHAKE256_RATE/8 - 1) { st[k] = v; }
    }

    st = _keccakf1600_avx2x4(st);

    // squeeze the first n bytes of every lane
    () = #unspill(out);
    for l=0 to 4 {
        for k=0 to SPX_N/8 {
            t = st[:u64 4*k + l];
            out.[:u64 l*SPX_N + 8*k] = t;
        }
    }

    return out;
}

fn thash_x4(
    reg ptr u8[4*SPX_N] out,  // output: four n-byte hashes
    reg ptr u8[4*MLEN] in,    // four MLEN-byte messages, concatenated
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs,      // ADRS (words 0..5 shared by the lanes)
    reg ptr u32[4*(2+KP)] w67 // ADRS words 6 and 7 (KP = 1: and 5) of every lane
) -> reg ptr u8[4*SPX_N] // -> out
{
    out = __thash_x4(out, in, pkseed, adrs, w67);
    return out;
}

// thash_x4 in place, for MLEN = n: io_l = thash(io_l), l = 0..3
fn thash_x4_io(
    reg ptr u8[4*MLEN] io,    // in/out: four n-byte values
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs,      // ADRS (words 0..5 shared by the lanes)
    reg ptr u32[4*(2+KP)] w67 // ADRS words 6 and 7 (KP = 1: and 5) of every lane
) -> reg ptr u8[4*MLEN] // -> io
{
    io[0 : 4*SPX_N] = __thash_x4(io[0 : 4*SPX_N], io, pkseed, adrs, w67);
    return io;
}
