require "sha256/core_hash_sha256.jinc"
require "../adrs/adrs.jinc" // ADRS data structure

require "../stdlib/memcpy/memcpy.jinc" // for copying SPX_N-byte strings

// H_msg(R, PK.seed, PK.root, M) = MGF1-SHA-256(R || PK.seed || SHA-256(R || PK.seed || PK.root || M), m)
fn H_msg(
    #[spill_to_mmx] reg ptr u8[SPX_M] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] r,      // message randomiser
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u8[SPX_N] pkroot, // PK.root
    reg u64 ctx_ptr,          // context pointer
    reg u64 ctx_len,          // context length
    reg u64 msg_ptr,          // message pointer
    reg u64 msg_len           // message length
) -> reg ptr u8[SPX_M] // -> out
{
    () = #spill(out); // only needed at the end of the function

    // stack variables
    stack u8[3*SPX_N] buf; // buffer for the inner hash call
    stack u8[2*SPX_N + SHA256_OUT + 4] seed; // buffer for the seed concatenated with a 4-byte counter
    stack u8[((SPX_M + SHA256_OUT - 1) / SHA256_OUT) * SHA256_OUT] concat; // concatenated hash outputs

    inline int i;
    inline int hash_nr;

    // copy R into both buffers
    buf[0 : SPX_N]  = __copy_nbytes(buf[0 : SPX_N],  r);
    seed[0 : SPX_N] = __copy_nbytes(seed[0 : SPX_N], r);

    // copy PK.seed into both buffers
    buf[SPX_N : SPX_N]  = __copy_nbytes(buf[SPX_N : SPX_N],  pkseed);
    seed[SPX_N : SPX_N] = __copy_nbytes(seed[SPX_N : SPX_N], pkseed);

    // copy PK.root into the inner buffer
    buf[2*SPX_N : SPX_N] = __copy_nbytes(buf[2*SPX_N : SPX_N], pkroot);

    // compute the inner hash value = sha256(R || PK.seed || PK.root || M)
    seed[2*SPX_N : SHA256_OUT] = sha256_mgf1_msg::sha256_absorb(seed[2*SPX_N : SHA256_OUT], buf, ctx_ptr, ctx_len, msg_ptr, msg_len);

    // set the first three of the four bytes of the counter to 0
    // (for all approved parameter sets, we will never need > 255 hash output concatenations)
    for i=0 to 3 { seed[2*SPX_N + SHA256_OUT + i] = 0; }

    // need ceil(SPX_M / SHA256_OUT) hashes of SHA256_OUT bytes each, to surpass at least SPX_M bytes
    for hash_nr=0 to (SPX_M + SHA256_OUT - 1) / SHA256_OUT {
        // set the last byte of 'seed' to the hash iteration counter
        seed[2*SPX_N + SHA256_OUT + 3] = (8u) hash_nr;

        // compute sha256(seed), where seed includes the counter
        concat[hash_nr*SHA256_OUT : SHA256_OUT] = sha256_mgf1_seed::sha256(concat[hash_nr*SHA256_OUT : SHA256_OUT], seed);
    }

    () = #unspill(out);

    // truncate the concatenated hash outputs to the correct length by copying only the first SPX_M bytes
    for i=0 to SPX_M { out[i] = concat[i]; }
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __H_msg(
    reg ptr u8[SPX_M] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] r,      // message randomiser
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u8[SPX_N] pkroot, // PK.root
    reg u64 ctx_ptr,          // context pointer
    reg u64 ctx_len,          // context length
    reg u64 msg_ptr,          // message pointer
    reg u64 msg_len           // message length
) -> reg ptr u8[SPX_M] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; r = r; pkseed = pkseed; pkroot = pkroot; ctx_ptr = ctx_ptr; ctx_len = ctx_len; msg_ptr = msg_ptr; msg_len = msg_len;

    out = H_msg(out, r, pkseed, pkroot, ctx_ptr, ctx_len, msg_ptr, msg_len);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// PRF_msg(SK.prf, optrand, M) = Trunc_n(HMAC-SHA-256(SK.prf, optrand || M))
fn PRF_msg(
    #[spill_to_mmx] reg ptr u8[SPX_N] out,     // output: buffer the result gets written to
    reg ptr u8[SPX_N] skprf,   // SK.prf
    reg ptr u8[SPX_N] optrand, // (optional) additional randomness
    reg u64 ctx_ptr,           // context pointer
    reg u64 ctx_len,           // context length
    reg u64 msg_ptr,           // message pointer
    reg u64 msg_len            // message length
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // not needed until the end of the function

    // register variables
    reg u64 xor; // temporary variable for computing XORs

    // stack variables
    stack u8[SHA256_IN] key;               // buffer for the key
    stack u8[SHA256_IN + SPX_N] ibuf;      // buffer for inner hash call
    stack u8[SHA256_IN + SHA256_OUT] obuf; // buffer for outer hash call
    stack u8[SHA256_OUT] hmac;

    inline int i;

    // set key = SK.prf || 00..0
    key[0 : SPX_N] = __copy_nbytes(key[0 : SPX_N], skprf); // first part of the key is SK.prf
    for i=SPX_N to SHA256_IN { key[i] = 0; } // pad the rest of the key with zeroes

    // compute ibuf = (key XOR ipad) eight bytes at a time
    // reading a u64 word of a byte array incurs an Endianness byteswap,
    // but we also write a u64 word to a byte array which undoes the byteswap
    for i=0 to SHA256_IN/8 {
        xor = 0x3636363636363636; // set ipad
        xor ^= key[:u64 i];       // bitwise xor ipad with the key
        ibuf[:u64 i] = xor;
    }
    // compute obuf = (key XOR opad) eight bytes at a time
    // reading a u64 word of a byte array incurs an Endianness byteswap,
    // but we also write a u64 word to a byte array which undoes the byteswap
    for i=0 to SHA256_IN/8 {
        xor = 0x5C5C5C5C5C5C5C5C; // set opad
        xor ^= key[:u64 i];       // bitwise xor opad with the key
        obuf[:u64 i] = xor;
    }

    // append optrand to ibuf
    // i.e. ibuf = (key xor ipad) || optrand
    ibuf[SHA256_IN : SPX_N] = __copy_nbytes(ibuf[SHA256_IN : SPX_N], optrand);

    // compute inner = sha256((key xor ipad) || optrand || M)
    obuf[SHA256_IN : SHA256_OUT] = sha256_hmac_inner::sha256_absorb(obuf[SHA256_IN : SHA256_OUT], ibuf, ctx_ptr, ctx_len, msg_ptr, msg_len);

    // compute hmac = sha256((key xor opad) || inner)
    hmac = sha256_hmac_outer::sha256(hmac, obuf);

    () = #unspill(out);

    // truncate hmac to the correct length by copying only the first SPX_N bytes
    out = __copy_nbytes(out, hmac[0 : SPX_N]);
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __PRF_msg(
    reg ptr u8[SPX_N] out,     // output: buffer the result gets written to
    reg ptr u8[SPX_N] skprf,   // SK.prf
    reg ptr u8[SPX_N] optrand, // (optional) additional randomness
    reg u64 ctx_ptr,           // context pointer
    reg u64 ctx_len,           // context length
    reg u64 msg_ptr,           // message pointer
    reg u64 msg_len            // message length
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; skprf = skprf; optrand = optrand; ctx_ptr = ctx_ptr; ctx_len = ctx_len; msg_ptr = msg_ptr; msg_len = msg_len;

    out = PRF_msg(out, skprf, optrand, ctx_ptr, ctx_len, msg_ptr, msg_len);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// PRF(PK.seed, SK.seed, ADRS) = Trunc_n(SHA-256(PK.seed || toByte(0,64-n) || ADRS^c || SK.seed))
fn PRF(
    #[spill_to_mmx] reg ptr u8[SPX_N] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg ptr u32[8] adrs,      // ADRS
    reg ptr u8[96] h_cache    // cached SHA2 state
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // not needed until the end of the function

    // stack buffer that will contain the concatenated inputs
    stack u8[22 + SPX_N] buf;

    // buffer for the output
    stack u8[SHA256_OUT] digest;

    // buf = ADRS^c
    buf[0 : 22] = __adrs_compress(buf[0 : 22], adrs);

    // buf = ADRS^c || SK.seed
    buf[22 : SPX_N] = __copy_nbytes(buf[22 : SPX_N], skseed);

    // compute digest = sha256(PK.seed || zero-padding || ADRS^c || SK.seed)
    // (cached sha2 state contains the internal state after hashing the first input block consisting of PK.seed || zero-padding)
    digest = sha256_tl_1n::sha256_cached(digest, buf, h_cache);

    () = #unspill(out);

    // truncate the digest to the correct length by copying only the first SPX_N bytes
    out = __copy_nbytes(out, digest[0 : SPX_N]);
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __PRF(
    reg ptr u8[SPX_N] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg ptr u32[8] adrs,      // ADRS
    reg ptr u8[96] h_cache    // cached SHA2 state
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; skseed = skseed; adrs = adrs; h_cache = h_cache;

    out = PRF(out, skseed, adrs, h_cache);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// F(PK.seed, ADRS, M_1) = Trunc_n(SHA-256(PK.seed || toByte(0,64-n) || ADRS^c || M_1))
fn F(
    #[spill_to_mmx] reg ptr u8[SPX_N] out,    // both input and output (F is in-place)
    reg ptr u32[8] adrs,      // ADRS
    reg ptr u8[96] h_cache    // cached SHA2 state
) -> reg ptr u8[SPX_N] // -> out
{
    // stack buffer that will contain the concatenated inputs
    stack u8[22 + SPX_N] buf;

    // buffer for the output
    stack u8[SHA256_OUT] digest;

    // buf = ADRS^c
    buf[0 : 22] = __adrs_compress(buf[0 : 22], adrs);

    // buf = ADRS^c || M_1
    buf[22 : SPX_N] = __copy_nbytes(buf[22 : SPX_N], out);
    () = #spill(out); // only needed again at the end of the function

    // compute digest = sha256(PK.seed || zero-padding || ADRS^c || M_1)
    // (cached sha2 state contains the internal state after hashing the first input block consisting of PK.seed || zero-padding)
    digest = sha256_tl_1n::sha256_cached(digest, buf, h_cache);

    () = #unspill(out);

    // truncate the digest to the correct length by copying only the first SPX_N bytes
    out = __copy_nbytes(out, digest[0 : SPX_N]);
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __F(
    reg ptr u8[SPX_N] out,    // both input and output (F is in-place)
    reg ptr u32[8] adrs,      // ADRS
    reg ptr u8[96] h_cache    // cached SHA2 state
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; adrs = adrs; h_cache = h_cache;

    out = F(out, adrs, h_cache);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// H(PK.seed, ADRS, M_2) = Trunc_n(SHA-256(PK.seed || toByte(0,64-n) || ADRS^c || M_2))
fn H(
    #[spill_to_mmx] reg ptr u8[SPX_N] out,    // output: buffer the result gets written to
    reg ptr u32[8] adrs,      // ADRS
    reg ptr u8[SPX_N] in1,    // first part of the concatenation
    reg ptr u8[SPX_N] in2,    // second part of the concatenation
    reg ptr u8[96] h_cache    // cached SHA2 state
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // not needed until the end of the function

    // stack buffer that will contain the concatenated inputs
    stack u8[22 + 2*SPX_N] buf;

    // buffer for the output
    stack u8[SHA256_OUT] digest;

    // buf = ADRS^c
    buf[0 : 22] = __adrs_compress(buf[0 : 22], adrs);

    // buf = ADRS^c || M_2
    buf[22       : SPX_N] = __copy_nbytes(buf[22       : SPX_N], in1);
    buf[22+SPX_N : SPX_N] = __copy_nbytes(buf[22+SPX_N : SPX_N], in2);

    // compute digest = sha256(PK.seed || zero-padding || ADRS^c || M_2)
    // (cached sha2 state contains the internal state after hashing the first input block consisting of PK.seed || zero-padding)
    digest = sha256_tl_2n::sha256_cached(digest, buf, h_cache);

    () = #unspill(out);

    // truncate the digest to the correct length by copying only the first SPX_N bytes
    out = __copy_nbytes(out, digest[0 : SPX_N]);
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __H(
    reg ptr u8[SPX_N] out,    // output: buffer the result gets written to
    reg ptr u32[8] adrs,      // ADRS
    reg ptr u8[SPX_N] in1,    // first part of the concatenation
    reg ptr u8[SPX_N] in2,    // second part of the concatenation
    reg ptr u8[96] h_cache    // cached SHA2 state
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; adrs = adrs; in1 = in1; in2 = in2; h_cache = h_cache;

    out = H(out, adrs, in1, in2, h_cache);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// T_len(PK.seed, ADRS, M_len) = Trunc_n(SHA-256(PK.seed || toByte(0,64-n) || ADRS^c || M_len))
fn T_len(
    #[spill_to_mmx] reg ptr u8[SPX_N] out,            // output: buffer the result gets written to
    reg ptr u32[8] adrs,              // ADRS
    reg ptr u8[SPX_LEN*SPX_N] chains, // concatenation of all chain end values in a WOTS instance
    reg ptr u8[96] h_cache            // cached SHA2 state
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // not needed until the end of the function

    // stack buffer that will contain the concatenated inputs
    stack u8[22 + SPX_LEN*SPX_N] buf;

    // buffer for the output
    stack u8[SHA256_OUT] digest;

    inline int i;

    // buf = ADRS^c
    buf[0 : 22] = __adrs_compress(buf[0 : 22], adrs);

    // buf = ADRS^c || M_len
    for i=0 to SPX_LEN {
        buf[22+i*SPX_N : SPX_N] = __copy_nbytes(buf[22+i*SPX_N : SPX_N], chains[i*SPX_N : SPX_N]);
    }

    // compute digest = sha256(PK.seed || zero-padding || ADRS^c || M_len)
    // (cached sha2 state contains the internal state after hashing the first input block consisting of PK.seed || zero-padding)
    digest = sha256_compress_wots::sha256_cached(digest, buf, h_cache);

    () = #unspill(out);

    // truncate the message digest to the correct length by copying only the first SPX_N bytes
    out = __copy_nbytes(out, digest[0 : SPX_N]);
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __T_len(
    reg ptr u8[SPX_N] out,            // output: buffer the result gets written to
    reg ptr u32[8] adrs,              // ADRS
    reg ptr u8[SPX_LEN*SPX_N] chains, // concatenation of all chain end values in a WOTS instance
    reg ptr u8[96] h_cache            // cached SHA2 state
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; adrs = adrs; chains = chains; h_cache = h_cache;

    out = T_len(out, adrs, chains, h_cache);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// T_k(PK.seed, ADRS, M_k) = Trunc_n(SHA-256(PK.seed || toByte(0,64-n) || ADRS^c || M_k))
fn T_k(
    #[spill_to_mmx] reg ptr u8[SPX_N] out,         // output: buffer the result gets written to
    reg ptr u32[8] adrs,           // ADRS
    reg ptr u8[SPX_K*SPX_N] roots, // concatenation of all roots in a FORS forest
    reg ptr u8[96] h_cache         // cached SHA2 state
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // not needed until the end of the function

    // stack buffer that will contain the concatenated inputs
    stack u8[22 + SPX_K*SPX_N] buf;

    // buffer for the output
    stack u8[SHA256_OUT] digest;

    inline int i;

    // buf = ADRS^c
    buf[0 : 22] = __adrs_compress(buf[0 : 22], adrs);

    // buf = ADRS^c || M_k
    for i=0 to SPX_K {
        buf[22+i*SPX_N : SPX_N] = __copy_nbytes(buf[22+i*SPX_N : SPX_N], roots[i*SPX_N : SPX_N]);
    }

    // compute digest = sha256(PK.seed || zero-padding || ADRS^c || M_k)
    // (cached sha2 state contains the internal state after hashing the first input block consisting of PK.seed || zero-padding)
    digest = sha256_compress_fors::sha256_cached(digest, buf, h_cache);

    () = #unspill(out);

    // truncate the message digest to the correct length by copying only the first SPX_N bytes
    out = __copy_nbytes(out, digest[0 : SPX_N]);
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __T_k(
    reg ptr u8[SPX_N] out,         // output: buffer the result gets written to
    reg ptr u32[8] adrs,           // ADRS
    reg ptr u8[SPX_K*SPX_N] roots, // concatenation of all roots in a FORS forest
    reg ptr u8[96] h_cache         // cached SHA2 state
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; adrs = adrs; roots = roots; h_cache = h_cache;

    out = T_k(out, adrs, roots, h_cache);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

/********** PARALLELISED HASHES **********/

// the cached SHA256 state (of PK.seed || padding) broadcast to every lane,
// for H_adrs: computed once by the callers, for all their H_adrs calls
inline
fn __H_state_cache(
    reg ptr u256[SHA2_STATE_WORD_SIZE] h_cache, // out: vectorised cached SHA256 state
    reg ptr u8[96] sha2_state_caches            // combined SHA256 and SHA512 state caches
) -> reg ptr u256[SHA2_STATE_WORD_SIZE] // -> h_cache
{
    // register variables
    reg u256 state_vector; // temporary variable for copying purposes

    // stack variables
    stack u32 state_word;   // VPBROADCAST takes a memory operand

    inline int i;

    for i=0 to SHA2_STATE_WORD_SIZE {
        state_word = sha2_state_caches[:u32 i];  // get one word from the state
        state_vector = #VPBROADCAST_8u32(state_word); // broadcast it to every lane in a 256-bit wide register
        h_cache[i] = state_vector;                // store the vectorised state word
    }

    return h_cache;
}

// initialise a SHA256 instance from a cached state, and construct and absorb the correct ADRS^c into the state
fn H_adrs(
    reg ptr u256[SHA2_STATE_WORD_SIZE] state,   // Intermediate Hash Values (IHVs)
    reg ptr u256[SHA2_ROUNDS_NUM] schedule,     // message schedule
    reg u64 sch_idx,                            // byte index of the current position in message schedule
    reg u64 bits,                               // number of bits processed
    reg ptr u256[SHA2_STATE_WORD_SIZE] h_cache, // vectorised cached SHA256 state (__H_state_cache)
    reg ptr u32[8] adrs,                        // ADRS for the first hash
    reg u32 tree_index                          // tree index of the leftmost input node
) -> reg ptr u256[SHA2_STATE_WORD_SIZE], reg ptr u256[SHA2_ROUNDS_NUM], reg u64, reg u64 // -> state, schedule, sch_idx, bits
{
    // register variables
    reg u32 index;  // tree index of a lane
    reg u64 t0 t1;  // ADRS^c bytes 0 .. 15
    reg u16 t2;     // ADRS^c bytes 16 .. 17

    // stack variables
    stack u8[8*22] adrscs; // ADRS^c of every hash

    inline int j;

    // initialise the SHA256 vectorised state
    bits = SHA256_IN*8; // exactly one block  of input was consumed to get the cached state
    state, schedule, sch_idx, bits = sha256_parallel::init_cache(state, schedule, sch_idx, bits, h_cache);

    // ADRS^c for the first hash (ADRS already has its tree index), and for the
    // other hashes its first 18 bytes, then the tree index (bytes 18 .. 21)
    adrscs[0 : 22] = __adrs_compress(adrscs[0 : 22], adrs);
    t0 = adrscs.[:u64 0];
    t1 = adrscs.[:u64 8];
    t2 = adrscs.[:u16 16];
    index = tree_index;
    for j=1 to 8 {
        adrscs.[:u64 22*j]      = t0;
        adrscs.[:u64 22*j + 8]  = t1;
        adrscs.[:u16 22*j + 16] = t2;
        index += 1;
        adrscs[j*22 : 22] = __adrsc_set_tree_index(adrscs[j*22 : 22], index);
    }

    // absorb ADRS^C into the parallelised state
    state, schedule, sch_idx, bits = sha256_parallel_adrsc::absorb_fixed(state, schedule, sch_idx, bits, adrscs[0*22 : 22], adrscs[1*22 : 22], adrscs[2*22 : 22], adrscs[3*22 : 22], adrscs[4*22 : 22], adrscs[5*22 : 22], adrscs[6*22 : 22], adrscs[7*22 : 22]);

    return state, schedule, sch_idx, bits;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __H_adrs(
    reg ptr u256[SHA2_STATE_WORD_SIZE] state, // Intermediate Hash Values (IHVs)
    reg ptr u256[SHA2_ROUNDS_NUM] schedule,   // message schedule
    reg u64 sch_idx,                          // byte index of the current position in message schedule
    reg u64 bits,                             // number of bits processed
    reg ptr u256[SHA2_STATE_WORD_SIZE] h_cache, // vectorised cached state (__H_state_cache)
    reg ptr u32[8] adrs,                      // ADRS for the first hash
    reg u32 tree_index                        // tree index of the leftmost input node
) -> reg ptr u256[SHA2_STATE_WORD_SIZE], reg ptr u256[SHA2_ROUNDS_NUM], reg u64, reg u64 // -> state, schedule, sch_idx, bits
{
    // split live-range of the input parameters into two segments
    state = state; schedule = schedule; sch_idx = sch_idx; bits = bits; h_cache = h_cache; adrs = adrs; tree_index = tree_index;

    state, schedule, sch_idx, bits = H_adrs(state, schedule, sch_idx, bits, h_cache, adrs, tree_index);

    // split live-range of the output parameters into two segments
    state = state; schedule = schedule; sch_idx = sch_idx; bits = bits;

    return state, schedule, sch_idx, bits;
}

// absorb the child node inputs for every parallel instance
fn H_children(
    reg ptr u256[SHA2_STATE_WORD_SIZE] state,        // Intermediate Hash Values (IHVs)
    reg ptr u256[SHA2_ROUNDS_NUM] schedule,          // message schedule
    reg u64 sch_idx,                                 // byte index of the current position in message schedule
    reg u64 bits,                                    // number of bits processed
    #[spill_to_mmx] reg ptr u8[2 * SHA2_H_PARA_DEG * SPX_N] children // array pointer containing all children (interleaved left/right/left/.../right)
) -> reg ptr u256[SHA2_STATE_WORD_SIZE], reg ptr u256[SHA2_ROUNDS_NUM], reg u64, reg u64 // -> state, schedule, sch_idx, bits
{
    // register variables
    reg ptr u8[SPX_N] lnode0 lnode1 lnode2 lnode3 lnode4 lnode5 lnode6 lnode7; // left children
    reg ptr u8[SPX_N] rnode0 rnode1 rnode2 rnode3 rnode4 rnode5 rnode6 rnode7; // right children

    // get the pointers to all of the left children
    lnode0 = children[(0+0*2) * SPX_N : SPX_N];
    lnode1 = children[(0+1*2) * SPX_N : SPX_N];
    lnode2 = children[(0+2*2) * SPX_N : SPX_N];
    lnode3 = children[(0+3*2) * SPX_N : SPX_N];
    lnode4 = children[(0+4*2) * SPX_N : SPX_N];
    lnode5 = children[(0+5*2) * SPX_N : SPX_N];
    lnode6 = children[(0+6*2) * SPX_N : SPX_N];
    lnode7 = children[(0+7*2) * SPX_N : SPX_N];

    // consume all left children into the parallelised state
    () = #spill(children); // make space in the registers
    state, schedule, sch_idx, bits = sha256_parallel_n::absorb_fixed(state, schedule, sch_idx, bits, lnode0, lnode1, lnode2, lnode3, lnode4, lnode5, lnode6, lnode7);
    () = #unspill(children);

    // get the pointers to all of the right children
    rnode0 = children[(1+0*2) * SPX_N : SPX_N];
    rnode1 = children[(1+1*2) * SPX_N : SPX_N];
    rnode2 = children[(1+2*2) * SPX_N : SPX_N];
    rnode3 = children[(1+3*2) * SPX_N : SPX_N];
    rnode4 = children[(1+4*2) * SPX_N : SPX_N];
    rnode5 = children[(1+5*2) * SPX_N : SPX_N];
    rnode6 = children[(1+6*2) * SPX_N : SPX_N];
    rnode7 = children[(1+7*2) * SPX_N : SPX_N];

    // consume all right children into the parallelised state
    state, schedule, sch_idx, bits = sha256_parallel_n::absorb_fixed(state, schedule, sch_idx, bits, rnode0, rnode1, rnode2, rnode3, rnode4, rnode5, rnode6, rnode7);

    return state, schedule, sch_idx, bits;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __H_children(
    reg ptr u256[SHA2_STATE_WORD_SIZE] state,        // Intermediate Hash Values (IHVs)
    reg ptr u256[SHA2_ROUNDS_NUM] schedule,          // message schedule
    reg u64 sch_idx,                                 // byte index of the current position in message schedule
    reg u64 bits,                                    // number of bits processed
    reg ptr u8[2 * SHA2_H_PARA_DEG * SPX_N] children // array pointer containing all children (interleaved left/right/left/.../right)
) -> reg ptr u256[SHA2_STATE_WORD_SIZE], reg ptr u256[SHA2_ROUNDS_NUM], reg u64, reg u64 // -> state, schedule, sch_idx, bits
{
    // split live-range of the input parameters into two segments
    state = state; schedule = schedule; sch_idx = sch_idx; bits = bits; children = children;

    state, schedule, sch_idx, bits = H_children(state, schedule, sch_idx, bits, children);

    // split live-range of the output parameters into two segments
    state = state; schedule = schedule; sch_idx = sch_idx; bits = bits;

    return state, schedule, sch_idx, bits;
}

// finish the SHA256 computations and write the truncated outputs for every parallel instance
fn H_digests(
    reg ptr u256[SHA2_STATE_WORD_SIZE] state, // Intermediate Hash Values (IHVs)
    reg ptr u256[SHA2_ROUNDS_NUM] schedule,   // message schedule
    reg u64 sch_idx,                          // byte index of the current position in message schedule
    reg u64 bits,                             // number of bits processed
    #[spill_to_mmx] reg ptr u8[SHA2_H_PARA_DEG * SPX_N] nodes // out: array pointer with space for all output nodes
) -> reg ptr u8[SHA2_H_PARA_DEG * SPX_N], reg ptr u256[SHA2_ROUNDS_NUM] // -> nodes, schedule // schedule is only returned because it needs to be writable
{
    // stack variables
    stack u8[SHA256_OUT] node0 node1 node2 node3 node4 node5 node6 node7;

    // finalise all digests and write to the output nodes
    () = #spill(nodes); // free up space in the registers
    schedule, node0, node1, node2, node3, node4, node5, node6, node7 = sha256_parallel::finalise(state, schedule, sch_idx, bits, node0, node1, node2, node3, node4, node5, node6, node7);
    () = #unspill(nodes);

    // write (and truncate) the nodes to the output array
    nodes[0*SPX_N : SPX_N] = __copy_nbytes(nodes[0*SPX_N : SPX_N], node0[0 : SPX_N]);
    nodes[1*SPX_N : SPX_N] = __copy_nbytes(nodes[1*SPX_N : SPX_N], node1[0 : SPX_N]);
    nodes[2*SPX_N : SPX_N] = __copy_nbytes(nodes[2*SPX_N : SPX_N], node2[0 : SPX_N]);
    nodes[3*SPX_N : SPX_N] = __copy_nbytes(nodes[3*SPX_N : SPX_N], node3[0 : SPX_N]);
    nodes[4*SPX_N : SPX_N] = __copy_nbytes(nodes[4*SPX_N : SPX_N], node4[0 : SPX_N]);
    nodes[5*SPX_N : SPX_N] = __copy_nbytes(nodes[5*SPX_N : SPX_N], node5[0 : SPX_N]);
    nodes[6*SPX_N : SPX_N] = __copy_nbytes(nodes[6*SPX_N : SPX_N], node6[0 : SPX_N]);
    nodes[7*SPX_N : SPX_N] = __copy_nbytes(nodes[7*SPX_N : SPX_N], node7[0 : SPX_N]);

    return nodes, schedule;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __H_digests(
    reg ptr u256[SHA2_STATE_WORD_SIZE] state, // Intermediate Hash Values (IHVs)
    reg ptr u256[SHA2_ROUNDS_NUM] schedule,   // message schedule
    reg u64 sch_idx,                          // byte index of the current position in message schedule
    reg u64 bits,                             // number of bits processed
    reg ptr u8[SHA2_H_PARA_DEG * SPX_N] nodes // out: array pointer with space for all output nodes
) -> reg ptr u8[SHA2_H_PARA_DEG * SPX_N], reg ptr u256[SHA2_ROUNDS_NUM] // -> nodes, schedule // schedule is only returned because it needs to be writable
{
    // split live-range of the input parameters into two segments
    state = state; schedule = schedule; sch_idx = sch_idx; bits = bits; nodes = nodes;

    nodes, schedule = H_digests(state, schedule, sch_idx, bits, nodes);

    // split live-range of the output parameters into two segments
    nodes = nodes; schedule = schedule;

    return nodes, schedule;
}

// H on SHA2_H_PARA_DEG lanes that each have their own ADRS^c (H_adrs takes the
// consecutive tree indices of one layer): node_l = H(PK.seed, ADRS_l, children_2l || children_2l+1)
fn H_lanes(
    #[spill_to_mmx] reg ptr u8[SHA2_H_PARA_DEG * SPX_N] nodes,        // out: one node per lane
    reg ptr u8[2 * SHA2_H_PARA_DEG * SPX_N] children,                 // the two children of every lane, interleaved
    reg ptr u8[SHA2_H_PARA_DEG * 22] adrscs,                          // the ADRS^c of every lane
    reg ptr u8[96] sha2_state_caches                                  // combined SHA256 and SHA512 state caches
) -> reg ptr u8[SHA2_H_PARA_DEG * SPX_N] // -> nodes
{
    // stack variables
    stack u256[SHA2_STATE_WORD_SIZE] state;       // vectorised state
    stack u256[SHA2_ROUNDS_NUM] schedule;         // vectorised message schedule
    stack u256[SHA2_STATE_WORD_SIZE] state_cache; // vectorised cached SHA256 state
    stack u32 state_word;                         // temporary variable for copying purposes

    // register variables
    reg u256 state_vector; // temporary variable for copying purposes
    reg u64 sch_idx;       // byte index of the current position in message schedule
    reg u64 bits;          // number of bits processed

    inline int i;

    () = #spill(nodes);

    // the cached SHA256 state, in every lane
    for i=0 to SHA2_STATE_WORD_SIZE {
        state_word = sha2_state_caches[:u32 i];
        state_vector = #VPBROADCAST_8u32(state_word);
        state_cache[i] = state_vector;
    }

    sch_idx = 0;
    bits = SHA256_IN*8; // exactly one block of input was consumed to get the cached state
    state, schedule, sch_idx, bits = sha256_parallel::init_cache(state, schedule, sch_idx, bits, state_cache);

    // ADRS^c of every lane
    () = #spill(children);
    state, schedule, sch_idx, bits = sha256_parallel_adrsc::absorb_fixed(state, schedule, sch_idx, bits,
        adrscs[0*22 : 22], adrscs[1*22 : 22], adrscs[2*22 : 22], adrscs[3*22 : 22], adrscs[4*22 : 22], adrscs[5*22 : 22], adrscs[6*22 : 22], adrscs[7*22 : 22]);
    () = #unspill(children);
    _ = #init_msf(); // the unspilled pointer is public after the fence

    // the children of every lane
    state, schedule, sch_idx, bits = __H_children(state, schedule, sch_idx, bits, children);

    () = #unspill(nodes);
    _ = #init_msf(); // the unspilled pointer is public after the fence
    nodes, schedule = __H_digests(state, schedule, sch_idx, bits, nodes);

    return nodes;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __H_lanes(
    reg ptr u8[SHA2_H_PARA_DEG * SPX_N] nodes,
    reg ptr u8[2 * SHA2_H_PARA_DEG * SPX_N] children,
    reg ptr u8[SHA2_H_PARA_DEG * 22] adrscs,
    reg ptr u8[96] sha2_state_caches
) -> reg ptr u8[SHA2_H_PARA_DEG * SPX_N] // -> nodes
{
    nodes = nodes; children = children; adrscs = adrscs; sha2_state_caches = sha2_state_caches;

    nodes = H_lanes(nodes, children, adrscs, sha2_state_caches);

    nodes = nodes;

    return nodes;
}

// T_len of eight WOTS+ public keys at once (eight leaves of an XMSS tree):
// out_l = Trunc_n(SHA-256(PK.seed || toByte(0, 64-n) || ADRS^c_l || in_l)),
// with in_l = in[l*LEN*n : LEN*n], the LEN chain ends of leaf l
fn T_len_x8(
    #[spill_to_mmx] reg ptr u8[8*SPX_N] out,   // output: one n-byte value per lane
    #[spill_to_mmx] reg ptr u8[8*SPX_LEN*SPX_N] in, // the LEN chain ends of every lane, lane after lane
    reg ptr u8[8*22] adrscs,                   // the ADRS^c of every lane (type WOTS_PK)
    reg ptr u8[96] sha2_state_caches           // combined SHA256 and SHA512 state caches
) -> reg ptr u8[8*SPX_N] // -> out
{
    // stack variables
    stack u256[sha256_parallel::STATE_WORD_SIZE] state;       // vectorised state
    stack u256[sha256_parallel::ROUNDS_NUM] schedule;         // vectorised message schedule
    stack u256[sha256_parallel::STATE_WORD_SIZE] state_cache; // vectorised cached SHA-256 state
    stack u32 state_word;                                     // temporary variable for copying purposes
    stack u8[SHA256_OUT] d0 d1 d2 d3 d4 d5 d6 d7;            // full digests

    // register variables
    reg u256 state_vector; // temporary variable for copying purposes
    reg u64 sch_idx;       // byte index of the current position in message schedule
    reg u64 bits;          // number of bits processed

    inline int i;

    () = #spill(out);

    // the cached SHA-256 state, in every lane
    for i=0 to sha256_parallel::STATE_WORD_SIZE {
        state_word = sha2_state_caches[:u32 i];
        state_vector = #VPBROADCAST_8u32(state_word);
        state_cache[i] = state_vector;
    }

    sch_idx = 0;
    bits = SHA256_IN*8; // exactly one block of input was consumed to get the cached state
    state, schedule, sch_idx, bits = sha256_parallel::init_cache(state, schedule, sch_idx, bits, state_cache);

    // ADRS^c of every lane
    () = #spill(in);
    state, schedule, sch_idx, bits = sha256_parallel_adrsc::absorb_fixed(state, schedule, sch_idx, bits,
        adrscs[0*22 : 22], adrscs[1*22 : 22], adrscs[2*22 : 22], adrscs[3*22 : 22],
        adrscs[4*22 : 22], adrscs[5*22 : 22], adrscs[6*22 : 22], adrscs[7*22 : 22]);
    () = #unspill(in);
    _ = #init_msf(); // the unspilled pointer is public after the fence

    // the chain ends of every lane
    state, schedule, sch_idx, bits = sha256_parallel_tlen::absorb_fixed(state, schedule, sch_idx, bits,
        in[0*SPX_LEN*SPX_N : SPX_LEN*SPX_N], in[1*SPX_LEN*SPX_N : SPX_LEN*SPX_N],
        in[2*SPX_LEN*SPX_N : SPX_LEN*SPX_N], in[3*SPX_LEN*SPX_N : SPX_LEN*SPX_N],
        in[4*SPX_LEN*SPX_N : SPX_LEN*SPX_N], in[5*SPX_LEN*SPX_N : SPX_LEN*SPX_N],
        in[6*SPX_LEN*SPX_N : SPX_LEN*SPX_N], in[7*SPX_LEN*SPX_N : SPX_LEN*SPX_N]);

    schedule, d0, d1, d2, d3, d4, d5, d6, d7 = sha256_parallel::finalise(state, schedule, sch_idx, bits, d0, d1, d2, d3, d4, d5, d6, d7);

    () = #unspill(out);
    _ = #init_msf(); // the unspilled pointer is public after the fence

    // truncate to n bytes
    out[0*SPX_N : SPX_N] = __copy_nbytes(out[0*SPX_N : SPX_N], d0[0 : SPX_N]);
    out[1*SPX_N : SPX_N] = __copy_nbytes(out[1*SPX_N : SPX_N], d1[0 : SPX_N]);
    out[2*SPX_N : SPX_N] = __copy_nbytes(out[2*SPX_N : SPX_N], d2[0 : SPX_N]);
    out[3*SPX_N : SPX_N] = __copy_nbytes(out[3*SPX_N : SPX_N], d3[0 : SPX_N]);
    out[4*SPX_N : SPX_N] = __copy_nbytes(out[4*SPX_N : SPX_N], d4[0 : SPX_N]);
    out[5*SPX_N : SPX_N] = __copy_nbytes(out[5*SPX_N : SPX_N], d5[0 : SPX_N]);
    out[6*SPX_N : SPX_N] = __copy_nbytes(out[6*SPX_N : SPX_N], d6[0 : SPX_N]);
    out[7*SPX_N : SPX_N] = __copy_nbytes(out[7*SPX_N : SPX_N], d7[0 : SPX_N]);

    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __T_len_x8(
    reg ptr u8[8*SPX_N] out,
    reg ptr u8[8*SPX_LEN*SPX_N] in,
    reg ptr u8[8*22] adrscs,
    reg ptr u8[96] sha2_state_caches
) -> reg ptr u8[8*SPX_N] // -> out
{
    out = out; in = in; adrscs = adrscs; sha2_state_caches = sha2_state_caches;

    out = T_len_x8(out, in, adrscs, sha2_state_caches);

    out = out;

    return out;
}
