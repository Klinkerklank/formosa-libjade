inline
fn __copy_nbytes (reg ptr u8[SPX_N] out in) -> reg ptr u8[SPX_N] {
    inline int i;

    // n is 16, 24 or 32, a multiple of 8: copy it as 64-bit words (unaligned
    // accesses, otherwise we get a "variable allocation: bad range alignment" error)
    for i=0 to SPX_N/8 {
        out.[:u64 8*i] = in.[:u64 8*i]; // copies in[8i..8i+7]
    }

    return out;
}
