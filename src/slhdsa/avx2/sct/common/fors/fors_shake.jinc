// namespace for the base_t computation of the FORS indices
namespace baseb_fors {
  param int B      = SPX_T;
  param int LG_B   = SPX_A;
  param int OUTLEN = SPX_K;
  param int INLEN  = SPX_MD_LEN;
  require "../misc/baseb.jinc" // algorithm 4 of SLH-DSS: base_2^b
}

/////////////////////// HELPER FUNCTIONS ///////////////////////

// compute the position (label) of a tree node in a FORS tree's flattened array,
// where the flattened array is a one-dimensional array with the nodes of each layer,
// starting with the leaves, all concatenated
inline
fn __forest_label(
    reg u32 i, // node's horizontal index
    reg u32 z  // node's height
) -> reg u64 { // -> label
    reg u64 label; // node's array label
    reg u32 exp;   // temporary variable for exponent computations
    reg u64 pow;   // temporary variable for power computations
    reg u64 imod;  // temporary variable for modulo computations

    // 2^(a+1)-1 is the total number of nodes in the tree
    // 2^(a+1-z)-1 is the total number of nodes from layer z upwards
    // 2^(a+1)-1 - (2^(a+1-z)-1) = 2^(a+1) - 2^(a+1-z),
    // is the label of the leftmost node in the target layer
    // i is the index in the target layer, but we need to account for the
    // fact that a horizontal index in FORS runs over all trees in the forest,
    // so the label we are looking for is 2^(h'+1) - 2^(h'+1-z) + (i mod 2^(a-z))

    // compute label = 2^(a+1)
    exp = SPX_A+1; // exp = a + 1
    pow = 1;       // pow = 2^0
    _, _, _, _, _, pow = #SHL(pow, exp); // pow = 2^(a+1)
    label = pow;   // label = 2^(a+1)

    // compute label = 2^(a+1) - 2^(a+1-z)
    exp -= z;     // exp = a + 1 - z
    pow = 1;      // pow = 2^0
    _, _, _, _, _, pow = #SHL(pow, exp); // pow = 2^(a+1-z)
    label -= pow; // label = 2^(a+1) - 2^(a+1-z)

    // compute label = 2^(a+1) - 2^(a+1-z) + (i mod 2^(a-z))
    pow >>= 1;      // pow = 2^(a-z)
    imod = (64u) i; // imod = i
    imod %= pow;    // imod = i mod 2^(a-z)
    label += imod;  // label = 2^(a+1) - 2^(a+1-z) + (i mod 2^(a-z))

    return label;
}

//////////////////////// MAIN FUNCTIONS ////////////////////////

/*-------------------------------------------------------------+
| ALGORITHM 14 FROM SLH-DSS (FIPS 205)                         |
| Generates a FORS private-key value.                          |
+-------------------------------------------------------------*/
fn fors_skgen(
    reg ptr u8[SPX_N] sk,     // output: FORS secret key value
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs,      // ADRS
    reg u32 idx               // secret key index
) -> reg ptr u8[SPX_N] // -> sk
{
    // stack variables
    stack u32[8] skadrs;

    // register variables
    reg u32 kpa; // ADRS key pair address

    // clone ADRS and set the correct type for computing FORS secret keys
    skadrs = __adrs_clone(skadrs, adrs);
    skadrs = __adrs_set_type_and_clear(skadrs, SPX_ADRS_TYPE_FORS_PRF);

    // get the key pair address from ADRS, and set it in skadrs
    kpa = __adrs_get_key_pair_addr(adrs);
    skadrs = __adrs_set_key_pair_addr(skadrs, kpa);

    // set the tree index
    skadrs = __adrs_set_tree_index(skadrs, idx);

    // compute the secret key value
    sk = __PRF(sk, pkseed, skseed, skadrs);

    return sk;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __fors_skgen(
    reg ptr u8[SPX_N] sk,     // output: FORS secret key value
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs,      // ADRS
    reg u32 idx               // secret key index
) -> reg ptr u8[SPX_N] // -> sk
{
    // split live-range of the parameters into two segments
    sk = sk; skseed = skseed; pkseed = pkseed; adrs = adrs; idx = idx;

    sk = fors_skgen(sk, skseed, pkseed, adrs, idx);

    // split live-range of the output parameters into two segments
    sk = sk;

    return sk;
}

// four consecutive FORS leaves idx, ..., idx+3 at once: the secret key values
// PRF(PK.seed, SK.seed, skADRS) and their hashes F(PK.seed, ADRS, sk)
fn fors_leaves_x4(
    #[spill_to_mmx] reg ptr u8[4*SPX_N] leaves, // output: four leaf values
    reg ptr u8[SPX_N] skseed,                   // SK.seed
    reg ptr u8[SPX_N] pkseed,                   // PK.seed
    reg ptr u32[8] adrs,                        // ADRS (type FORS_TREE, key pair address set)
    reg u32 idx                                 // horizontal index of the first leaf
) -> reg ptr u8[4*SPX_N] // -> leaves
{
    // stack variables
    stack u8[4*SPX_N] seeds; // SK.seed in every lane
    stack u8[4*SPX_N] sks;   // the four secret key values
    stack u32[8] w67;        // tree height (0) and tree index of every lane
    stack u32[8] skadrs;     // skADRS

    // register variables
    reg u32 kpa;  // ADRS key pair address
    reg u32 zero;

    inline int j;

    () = #spill(leaves);

    for j=0 to 4 {
        seeds[j*SPX_N : SPX_N] = __copy_nbytes(seeds[j*SPX_N : SPX_N], skseed);
    }

    // height 0 and tree index idx + j in lane j, for skADRS and ADRS alike
    zero = 0;
    for j=0 to 4 {
        w67[2*j] = zero;
        w67[2*j+1] = idx;
        idx += 1;
    }

    // skADRS: type FORS_PRF, the key pair address of ADRS
    skadrs = __adrs_clone(skadrs, adrs);
    skadrs = __adrs_set_type_and_clear(skadrs, SPX_ADRS_TYPE_FORS_PRF);
    kpa = __adrs_get_key_pair_addr(adrs);
    skadrs = __adrs_set_key_pair_addr(skadrs, kpa);

    () = #spill(pkseed, adrs);
    sks = thash_x4_n::thash_x4(sks, seeds, pkseed, skadrs, w67);
    () = #unspill(pkseed, adrs, leaves);
    _ = #init_msf(); // the unspilled values are public after the fence

    leaves = thash_x4_n::thash_x4(leaves, sks, pkseed, adrs, w67);

    return leaves;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __fors_leaves_x4(
    reg ptr u8[4*SPX_N] leaves,
    reg ptr u8[SPX_N] skseed,
    reg ptr u8[SPX_N] pkseed,
    reg ptr u32[8] adrs,
    reg u32 idx
) -> reg ptr u8[4*SPX_N] // -> leaves
{
    leaves = leaves; skseed = skseed; pkseed = pkseed; adrs = adrs; idx = idx;

    leaves = fors_leaves_x4(leaves, skseed, pkseed, adrs, idx);

    leaves = leaves;

    return leaves;
}

/*-------------------------------------------------------------+
| ALGORITHM 15 FROM SLH-DSS (FIPS 205)                         |
| Computes the root of a Merkle subtree of FORS public values. |
| (iterative instead of recursive)                             |
+-------------------------------------------------------------*/
fn fors_node(
    reg ptr u8[SPX_N] root,   // output: root of the subtree rooted at i,z
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg u32 i,                // target node index (horizontal)
    reg u32 z,                // target node height
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs       // ADRS
) -> reg ptr u8[SPX_N], reg ptr u32[8] // -> root, adrs
{
    () = #spill(root);

    // stack variables
    stack u8[SPX_N] buf_l; // buffer holding the node value of the left child
    stack u8[SPX_N] buf_r; // buffer holding the node value of the right child

    // stack buffer with enough place to fit one entire (flattened) FORS tree
    // note that for efficiency only those nodes are computed that are needed
    // to find the target node, so not necessarily the entire buffer is filled
    stack u8[FORS_TREE_SIZE * SPX_N] flat_tree;

    // register variables
    reg u32 layer;     // iterator over the layers
    reg u32 node;      // node      = horizontal index   of the leftmost  node in the current layer
    reg u32 rightmost; // rightmost = horizontal index+1 of the rightmost node in the current layer
    reg u64 label;     // label of the current node
    reg u64 lnode;     // label of the left child
    reg u64 rnode;     // label of the right child
    reg u32 lnode_i;   // horizontal index of the left child
    reg u32 lnode_z;   // height of the left child
    reg u64 node_addr; // byte address of 'node' in the buffer
    reg u64 pow;       // temporary variable for computing powers
    reg u32 exp;       // temporary variable for computing exponents

    // four-way variables
    stack u32[8] w67;              // tree height and tree index of every lane
    stack u8[4*SPX_N] parents;     // the four parent nodes
    reg ptr u8[8*SPX_N] children;  // pointer to subarray with the eight child nodes
    reg ptr u8[4*SPX_N] leaves;    // pointer to subarray with four leaves
    reg u32 avail_nodes;           // number of nodes left to compute on the current layer
    reg u32 idx;                   // tree index of a lane

    inline int j;

    node_addr = 0; // assigned in the loops below; initialised for the SCT checker
    layer = 0; // iterate over the layers
    while (layer <= z) {
        () = #spill(z); // free up space in the registers

        // node      = horizontal index   of the leftmost  node in the current layer
        // rightmost = horizontal index+1 of the rightmost node in the current layer
        exp = z;                             // exp       = z
        exp -= layer;                        // exp       = z-layer
        pow = 1;                             // pow       = 2^0
        _, _, _, _, _, pow = #SHL(pow, exp); // pow       = 2^(z-layer)
        node       = (32u) pow;              // node      = 2^(z-layer)
        rightmost  = (32u) pow;              // rightmost = 2^(z-layer)
        node      *= i;                      // node      =  i    * 2^(z-layer)
        rightmost += node;                   // rightmost = (i+1) * 2^(z-layer)

        // iterate over the nodes within the current layer
        while (node < rightmost) {
            () = #spill(skseed, rightmost); // free up space in the registers

            if (layer == 0) {
                // layer-0 leaf node: the node value is a WOTS+ public key

                // set the correct values in ADRS for WOTS hashing
                adrs = __adrs_set_tree_height(adrs, layer);
                adrs = __adrs_set_tree_index(adrs, node);

                // compute the label of the current node
                label = __forest_label(node, layer); // label = forest_label(node, layer)

                // compute the byte address of the current node
                node_addr = label;  // node_addr = forest_label(node, layer)
                node_addr *= SPX_N; // node_addr = forest_label(node, layer) * SPX_N

                // compute how many leaves still need to be computed
                avail_nodes  = rightmost;
                avail_nodes -= node;

                // four leaves at a time when the subtree has at least four
                // (then it has a multiple of four, adjacent in flat_tree)
                if (avail_nodes >= 4) {
                    () = #spill(pkseed, adrs, i, layer, node, node_addr);
                    leaves = flat_tree[node_addr : 4*SPX_N];
                    leaves = __fors_leaves_x4(leaves, skseed, pkseed, adrs, node);
                    flat_tree[node_addr : 4*SPX_N] = leaves;
                    () = #unspill(pkseed, adrs, i, layer, node, node_addr);
                    _ = #init_msf(); // the unspilled values are public after the fence

                    // the loop advances one leaf, so skip the other three here
                    node += 3;
                } else {
                    // compute the FORS secret key value
                    () = #spill(pkseed, adrs, i, layer, node, node_addr);
                    flat_tree[node_addr : SPX_N] = __fors_skgen(flat_tree[node_addr : SPX_N], skseed, pkseed, adrs, node);
                    () = #unspill(pkseed, adrs, i, layer, node, node_addr);
                    _ = #init_msf(); // the unspilled values are public after the fence

                    // compute the hash of the FORS secret key value
                    () = #spill(pkseed, adrs, i, layer, node, node_addr);
                    flat_tree[node_addr : SPX_N] = __F(flat_tree[node_addr : SPX_N], pkseed, adrs);
                    () = #unspill(pkseed, adrs, i, layer, node, node_addr);
                    _ = #init_msf(); // the unspilled values are public after the fence
                }
            } else { // layer > 0
                // internal node: the node value is the hash of its two children lnode and rnode

                // compute the horizontal index and height of the left child
                lnode_i = node;  // lnode_i = node
                lnode_i *= 2;    // lnode_i = 2*node
                lnode_z = layer; // lnode_z = layer
                lnode_z -= 1;    // lnode_z = layer-1

                // compute the label of the left child
                label = __forest_label(lnode_i, lnode_z); // label = forest_label(2*node, layer-1)

                // compute the byte address of the left child
                lnode = label;  // lnode = forest_label(2*node, layer-1)
                lnode *= SPX_N; // lnode = forest_label(2*node, layer-1) * SPX_N

                // set the correct values in ADRS for tree node hashing
                // (ADRS type is already SPX_ADRS_TYPE_TREE, which is set
                // in spx.jinc, in slh_sign_internal and slh_verify_internal)
                adrs = __adrs_set_tree_height(adrs, layer);
                adrs = __adrs_set_tree_index(adrs, node);

                // compute the label of the parent node
                label = __forest_label(node, layer); // label = forest_label(node, layer)

                // compute the byte address of the parent node
                node_addr = label;  // node_addr = forest_label(node, layer)
                node_addr *= SPX_N; // node_addr = forest_label(node, layer) * SPX_N

                // compute how many nodes still need to be computed on this layer
                avail_nodes  = rightmost;
                avail_nodes -= node;

                if (avail_nodes >= 4) {
                    // four parents node, ..., node+3 at once: their eight
                    // children are adjacent in flat_tree, as are the parents

                    // tree height and tree index of every lane
                    for j=0 to 4 {
                        w67[2*j] = layer;
                        idx = node;
                        idx += j;
                        w67[2*j+1] = idx;
                    }

                    () = #spill(pkseed, adrs, i, layer, node, node_addr);
                    children = flat_tree[lnode : 8*SPX_N];
                    parents = thash_x4_2n::thash_x4(parents, children, pkseed, adrs, w67);
                    flat_tree[lnode : 8*SPX_N] = children;
                    () = #unspill(pkseed, adrs, i, layer, node, node_addr);
                    _ = #init_msf(); // the unspilled values are public after the fence

                    for j=0 to 4 {
                        flat_tree[node_addr + j*SPX_N : SPX_N] = __copy_nbytes(flat_tree[node_addr + j*SPX_N : SPX_N], parents[j*SPX_N : SPX_N]);
                    }

                    // the loop advances one node, so skip the other three here
                    node += 3;
                } else {
                    // compute the byte address of the right child, which by definition is adjoining the left child
                    rnode = lnode;  // rnode = forest_label(2*node,   layer-1) * SPX_N
                    rnode += SPX_N; // rnode = forest_label(2*node+1, layer-1) * SPX_N

                    // copy the children to buffers
                    // note: trying to pass the children to H as two reg ptr (to avoid the needless copying),
                    // gives the error that some reg ptr are not disjoint?
                    buf_l = __copy_nbytes(buf_l, flat_tree[lnode : SPX_N]);
                    buf_r = __copy_nbytes(buf_r, flat_tree[rnode : SPX_N]);

                    // compute node value = H(PK.seed, ADRS, lnode || rnode)
                    () = #spill(pkseed, adrs, i, layer, node, node_addr);
                    flat_tree[node_addr : SPX_N] = __H(flat_tree[node_addr : SPX_N], pkseed, adrs, buf_l, buf_r);
                    () = #unspill(pkseed, adrs, i, layer, node, node_addr);
                    _ = #init_msf(); // the unspilled values are public after the fence
                }
            }

            () = #unspill(skseed, rightmost);
            _ = #init_msf(); // the unspilled values are public after the fence

            // advance to the next node in the layer
            node += 1;
        }

        () = #unspill(z);
        _ = #init_msf(); // the unspilled values are public after the fence

        // advance to the next layer
        layer += 1;
    }

    () = #unspill(root);
    _ = #init_msf(); // the unspilled values are public after the fence

    // write the target node value to the output,
    // and the target node was the last node written to flat_tree,
    // so node_addr is still the correct byte address
    root = __copy_nbytes(root, flat_tree[node_addr : SPX_N]);
    return root, adrs;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __fors_node(
    reg ptr u8[SPX_N] root,   // output: root of the subtree rooted at i,z
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg u32 i,                // target node index (horizontal)
    reg u32 z,                // target node height
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs       // ADRS
) -> reg ptr u8[SPX_N], reg ptr u32[8] // -> root, adrs
{
    // split live-range of the parameters into two segments
    root = root; skseed = skseed; i = i; z = z; pkseed = pkseed; adrs = adrs;

    root, adrs = fors_node(root, skseed, i, z, pkseed, adrs);

    // split live-range of the output parameters into two segments
    root = root; adrs = adrs;

    return root, adrs;
}

/*-------------------------------------------------------------+
| ALGORITHM 16 FROM SLH-DSS (FIPS 205)                         |
| Generates a FORS signature.                                  |
+-------------------------------------------------------------*/
fn fors_sign(
    reg ptr u8[FORS_SIG] sig_fors, // output: FORS signature
    reg ptr u8[SPX_MD_LEN] md,     // message digest
    reg ptr u8[SPX_N] skseed,      // SK.seed
    reg ptr u8[SPX_N] pkseed,      // PK.seed
    reg ptr u32[8] adrs            // ADRS
) -> reg ptr u8[FORS_SIG], reg ptr u32[8] // -> sig_fors, adrs
{
    // stack variables
    stack u32[SPX_K] indices; // indices indicating leaf node per tree

    // reg variables
    reg ptr u8[SPX_N] node; // pointer to one n-byte secret key value or AUTH node in the FORS signature
    reg u64 i;        // iterator over the forest's trees
    reg u32 j;        // iterator over the authentication path nodes
    reg u32 idx_leaf; // horizontal index of a leaf
    reg u32 idx_sib;  // horizontal index of an authentication node's sibling
    reg u64 pow;      // temporary variable for power computations
    reg u32 exp;      // temporary variable for exponent computations
    reg u32 s;        // the sibling node's horizontal index
    reg u64 offset;   // byte offset of the tree nodes in the FORS signature

    // compute the base-t leaf indices
    indices = baseb_fors::__base_b(indices, md);

    offset = 0; // first node will get placed at the start of the FORS signature
    i = 0; // iterator over the forest's trees
    while (i < SPX_K) {
        // the leftmost leaf in the i-th FORS tree is i*2^a,
        // and the offset within the tree is indices[i], so the index
        // of the i-th tree's secret key value leaf is i*(2^a) + indices[i]
        idx_leaf = i;           // idx_leaf = 2^a
        idx_leaf <<= SPX_A;     // idx_leaf = i*(2^a)
        idx_leaf += indices[i]; // idx_leaf = i*(2^a) + indices[i]
        _ = #init_msf(); // the FORS index, loaded from memory, is public after the fence

        // compute the i-th FORS tree's secret key value
        node = sig_fors[offset : SPX_N]; // get the pointer to the subarray so the full array can be spilled
        () = #spill(skseed, pkseed, adrs, sig_fors, i, offset);
        node = __fors_skgen(node, skseed, pkseed, adrs, idx_leaf);
        () = #unspill(skseed, pkseed, adrs, sig_fors, i, offset);
        _ = #init_msf(); // the unspilled values are public after the fence
        sig_fors[offset : SPX_N] = node; // redesignate the pointer so the region of the full array is not partial

        offset += SPX_N; // one n-byte secret key value has been written

        // compute the sibling node's horizontal index
        s = indices[i]; // s = indices[i]
        _ = #init_msf(); // the FORS index, loaded from memory, is public after the fence
        s ^= 1;         // s = indices[i] XOR 1

        // compute and store the authentication path AUTH for the i-th tree in the forest
        j = 0; // iterator over the authentication path nodes
        while (j < SPX_A) {
            () = #spill(skseed, pkseed, i, j, offset, s);

            // the leftmost leaf in the i-th FORS tree then is i*2^(a-j)
            exp = SPX_A; // exp = a
            exp -= j;    // exp = a-j
            pow = i;     // pow = i
            _, _, _, _, _, pow = #SHL(pow, exp); // pow = i*2^(a-j)
            idx_sib = (32u) pow; // idx_sib = i*2^(a-j)
            idx_sib += s;        // idx_sib = i*2^(a-j) + (floor(indices[i] / 2^j) XOR 1)

            // compute the sibling node
            node = sig_fors[offset : SPX_N]; // get the pointer to the subarray so the full array can be spilled
            () = #spill(sig_fors);
            node, adrs = __fors_node(node, skseed, idx_sib, j, pkseed, adrs);
            () = #unspill(sig_fors);
            _ = #init_msf(); // the unspilled values are public after the fence
            sig_fors[offset : SPX_N] = node; // redesignate the pointer so the region of the full array is not partial

            () = #unspill(skseed, pkseed, i, j, offset, s);
            _ = #init_msf(); // the unspilled values are public after the fence

            // update the sibling node's horizontal index for the next iteration
            s >>= 1; // s = floor(indices[i] / 2^j)
            s ^= 1;  // s = floor(indices[i] / 2^j) XOR 1

            offset += SPX_N; // one n-byte node has been written
            j += 1; // advance to the next AUTH node
        }

        // advance to the next tree
        i += 1;
    }

    return sig_fors, adrs;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __fors_sign(
    reg ptr u8[FORS_SIG] sig_fors, // output: FORS signature
    reg ptr u8[SPX_MD_LEN] md,     // message digest
    reg ptr u8[SPX_N] skseed,      // SK.seed
    reg ptr u8[SPX_N] pkseed,      // PK.seed
    reg ptr u32[8] adrs            // ADRS
) -> reg ptr u8[FORS_SIG], reg ptr u32[8] // -> sig_fors, adrs
{
    // split live-range of the parameters into two segments
    sig_fors = sig_fors; md = md; skseed = skseed; pkseed = pkseed; adrs = adrs;

    sig_fors, adrs = fors_sign(sig_fors, md, skseed, pkseed, adrs);

    // split live-range of the output parameters into two segments
    sig_fors = sig_fors; adrs = adrs;

    return sig_fors, adrs;
}

/*-------------------------------------------------------------+
| ALGORITHM 17 FROM SLH-DSS (FIPS 205)                         |
| Computes a FORS public key from a FORS signature.            |
| The k trees are independent, so they are computed            |
| four at a time on the four-way Keccak: the leaves and the    |
| authentication paths (one height at a time) with thash_x4.   |
| Every lane has its own tree index; the order of a node and   |
| its authentication node follows the (public) leaf index,     |
| selected without branches.                                   |
+-------------------------------------------------------------*/
param int FORS_LANES = 4;                                                // trees per batch
param int FORS_KPAD = ((SPX_K + FORS_LANES - 1) / FORS_LANES) * FORS_LANES; // k rounded up to whole batches

fn fors_pkfromsig(
    reg ptr u8[SPX_N] pk_fors,       // output: compressed FORS public key
    reg ptr u8[FORS_SIG] sig_fors,   // FORS signature
    reg ptr u8[SPX_MD_LEN] md,       // message digest
    reg ptr u8[SPX_N] pkseed,        // PK.seed
    reg ptr u32[8] adrs              // ADRS
) -> reg ptr u8[SPX_N], reg ptr u32[8] // -> pk_fors, adrs
{
    () = #spill(pk_fors);

    // stack variables
    stack u32[SPX_K] indices;                                 // leaf index within every tree
    stack u32[FORS_LANES] gidx;                               // leaf index (over the forest) of every lane
    stack u8[FORS_KPAD*SPX_N] roots;                          // the roots, padded to whole batches
    stack u8[4*SPX_N] leaves_in;                              // the secret key values of the lanes
    stack u8[4*SPX_N] leaves;                                 // their hashes
    stack u8[FORS_LANES*SPX_N] nodes;                         // the current node of every lane
    stack u8[2*FORS_LANES*SPX_N] children;                    // the children of every lane
    stack u32[8] w67;                                         // tree height and tree index of every lane
    stack u8[SPX_N] seed;                                     // PK.seed, on the stack (its address public in the loop)
    stack u32[8] adrs_s;                                      // ADRS, on the stack (its address public in the loop)
    stack u32[8] forspkadrs;                                  // ADRS for compressing the roots

    // register variables
    reg u64 batch;  // batch index
    reg u64 t;      // tree of a lane
    reg u64 kmax;   // the last tree
    reg u64 off;    // byte offset in the signature
    reg u32 j;      // height of the current nodes
    reg u32 g;      // leaf index of a lane
    reg u32 bit;    // whether the node of a lane is a right child
    reg u8 js;      // j, as a shift count
    reg u32 h;      // tree height of the parents
    reg u32 kpa;    // ADRS key pair address
    reg u64 x y;    // temporary variables for copying

    inline int l w;

    // compute the base-t leaf indices
    indices = baseb_fors::__base_b(indices, md);

    seed = __copy_nbytes(seed, pkseed);
    adrs_s = __adrs_clone(adrs_s, adrs); // type FORS_TREE and the key pair address of ADRS

    () = #spill(sig_fors);

    batch = 0;
    while (batch < FORS_KPAD/FORS_LANES) {
        () = #unspill(sig_fors);
        _ = #init_msf(); // the unspilled values are public after the fence

        // the leaves: tree t = FORS_LANES*batch + l (the padding lanes repeat
        // the last tree), leaf index t*2^a + indices[t], height 0
        for l=0 to FORS_LANES {
            t = batch;
            t *= FORS_LANES;
            t += l;
            kmax = SPX_K - 1;
            t = kmax if (t > kmax);
            g = (32u) t;
            g <<= SPX_A;
            g += indices[t];
            gidx[l] = g;

            off = t;
            off *= (SPX_A + 1) * SPX_N;
            for w=0 to SPX_N/8 {
                x = sig_fors.[:u64 off + 8*w];
                leaves_in.[:u64 l*SPX_N + 8*w] = x;
            }

            w67[2*l] = 0;                    // tree height 0
            w67[2*l+1] = g;                  // tree index
        }

        () = #spill(batch);
        leaves = thash_x4_n::thash_x4(leaves, leaves_in, seed, adrs_s, w67);
        () = #unspill(batch);
        _ = #init_msf(); // the unspilled values are public after the fence

        for l=0 to FORS_LANES {
            for w=0 to SPX_N/8 {
                x = leaves.[:u64 l*SPX_N + 8*w];
                nodes.[:u64 l*SPX_N + 8*w] = x;
            }
        }

        // the authentication paths, one height at a time
        j = 0;
        while (j < SPX_A) {
            () = #unspill(sig_fors);
            _ = #init_msf(); // the unspilled values are public after the fence

            h = j;
            h += 1;

            for l=0 to FORS_LANES {
                t = batch;
                t *= FORS_LANES;
                t += l;
                kmax = SPX_K - 1;
                t = kmax if (t > kmax);

                // the authentication node at height j of tree t
                off = t;
                off *= (SPX_A + 1) * SPX_N;
                off += SPX_N;
                x = (64u) j;
                x *= SPX_N;
                off += x;

                // bit j of the leaf index: 0 when the node is a left child
                g = gidx[l];
                js = (8u) j;
                bit = g;
                _, _, _, _, _, bit = #SHR_32(bit, js);
                bit &= 1;

                // children = node || auth (bit 0) or auth || node (bit 1)
                for w=0 to SPX_N/8 {
                    x = nodes.[:u64 l*SPX_N + 8*w];
                    y = sig_fors.[:u64 off + 8*w];
                    children.[:u64 (2*l)*SPX_N + 8*w] = x;
                    children.[:u64 (2*l+1)*SPX_N + 8*w] = y;
                }
                for w=0 to SPX_N/8 {
                    x = children.[:u64 (2*l)*SPX_N + 8*w];
                    y = children.[:u64 (2*l+1)*SPX_N + 8*w];
                    x = y if (bit != 0);
                    y = nodes.[:u64 l*SPX_N + 8*w];
                    children.[:u64 (2*l)*SPX_N + 8*w] = x;
                    x = children.[:u64 (2*l+1)*SPX_N + 8*w];
                    x = y if (bit != 0);
                    children.[:u64 (2*l+1)*SPX_N + 8*w] = x;
                }

                // the parent: height j+1, tree index (leaf index) >> (j+1)
                w67[2*l] = h;
                _, _, _, _, _, g = #SHR_32(g, js);
                g >>= 1;
                w67[2*l+1] = g;
            }

            () = #spill(batch, j);
            nodes = thash_x4_2n::thash_x4(nodes, children, seed, adrs_s, w67);
            () = #unspill(batch, j);
            _ = #init_msf(); // the unspilled values are public after the fence

            j += 1;
        }

        // the roots of the batch (those of the padding lanes are never used)
        off = batch;
        off *= FORS_LANES*SPX_N;
        for l=0 to FORS_LANES {
            for w=0 to SPX_N/8 {
                x = nodes.[:u64 l*SPX_N + 8*w];
                roots.[:u64 off + l*SPX_N + 8*w] = x;
            }
        }

        batch += 1;
    }

    // set the correct ADRS values for FORS public key generation
    forspkadrs = __adrs_clone(forspkadrs, adrs_s);
    forspkadrs = __adrs_set_type_and_clear(forspkadrs, SPX_ADRS_TYPE_FORS_ROOTS);

    // get the key pair address from ADRS, and set it in forspkadrs
    kpa = __adrs_get_key_pair_addr(adrs_s);
    forspkadrs = __adrs_set_key_pair_addr(forspkadrs, kpa);

    () = #unspill(pk_fors);
    _ = #init_msf(); // the unspilled values are public after the fence

    pk_fors = __T_k(pk_fors, seed, forspkadrs, roots[0 : SPX_K*SPX_N]);

    return pk_fors, adrs;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __fors_pkfromsig(
    reg ptr u8[SPX_N] pk_fors,     // output: compressed FORS public key
    reg ptr u8[FORS_SIG] sig_fors, // FORS signature
    reg ptr u8[SPX_MD_LEN] md,     // message digest
    reg ptr u8[SPX_N] pkseed,      // PK.seed
    reg ptr u32[8] adrs            // ADRS
) -> reg ptr u8[SPX_N], reg ptr u32[8] // -> pk_fors, adrs
{
    // split live-range of the parameters into two segments
    pk_fors = pk_fors; sig_fors = sig_fors; md = md; pkseed = pkseed; adrs = adrs;

    pk_fors, adrs = fors_pkfromsig(pk_fors, sig_fors, md, pkseed, adrs);

    // split live-range of the output parameters into two segments
    pk_fors = pk_fors; adrs = adrs;

    return pk_fors, adrs;
}
